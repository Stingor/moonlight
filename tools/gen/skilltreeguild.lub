function GdDump()
	local out = ""
	for id, e in pairs(GUILD_SKILL_TREE) do
		local req = ""
		if e._NeedSkillList ~= nil then
			for _, r in ipairs(e._NeedSkillList) do
				if req ~= "" then req = req .. "|" end
				req = req .. r[1] .. ":" .. r[2]
			end
		end
		out = out .. id .. "," .. e.MaxLv .. "," .. e.SkillName .. "," .. req .. ";"
	end
	return out
end

