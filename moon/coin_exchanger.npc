//===== Moonlight-Destiny ===============================================//
//=======================================================================//
//																		 //
// NPCs Chien des Bois et Collectionneur								 //
//																		 //
//=======================================================================//
//																		 //
// Par Spider pour Moonlight Destiny									 //
//																		 //
// Crédit sprite et images de l'item : icabit du forum rAthena			 //
//																		 //
//=======================================================================//
//																		 //
// Chien des Bois échange un Moonlight Coin contre 1 milliard de zeny.	 //
//																		 //
// Collectionneur échange 1 milliard de zeny contre 1 Moonlight Coin.	 //
//																		 //
// Plus de soucis de stockage ni d'échange de gros volumes de zeny !	 //
//																		 //
//=======================================================================//




///////////////////////////////////////////////////////////////////////////
//																		 //
//								NPC 1									 //
//																		 //
///////////////////////////////////////////////////////////////////////////


gonryun,133,99,5	script	Chien des Bois	514,{
// Message de bienvenue
	mes "[Chien des Bois]";
	switch( rand(3) ) {
	case 0: mes "pssst pssssssst"; break;
	case 1: mes "Hé batard" + (Sex?"":"e"); break;
	case 2: mes "Woof Woof !"; break;
	}
	// Proposition
	sleep2 500; // sleep ne fonctionne pas avec un joueur attaché au npc
	mes "";
	mes "Tu veux des " + mesitemlink(Moonlight_Coin) + " ?";
	sleep2 200;
	mes "C'est ^FF00001.000.000.000^000000z l'unité";
	sleep2 200;
	mes "Allé sort la trésorerie t'atten quoi !";
	sleep2 200;
	mes "Et tu pose pas de questions";

	// Choix
	Menu "Tié ouf !",-, "Deal !", MenuBuyCoin;
	// Refus de l'échange & Message d'au revoir
	clear;
	mes "[Chien des Bois]";
	mes "Déblaye alors kess tu fai !";
	callsub Sub_IsSTN;
	close;

///////////////////////////////////////////////////////////////////////////
// Echange accepté
///////////////////////////////////////////////////////////////////////////
MenuBuyCoin:
	clear;
	mes "[Chien des Bois]";

	// Check zeny
	if (Zeny >= 1000000000) {
		// Message si assez de zeny
		switch( rand(3) ) {
		// Message d'accueil
		case 0: mes "Encore un" + (Sex?"":"e") + " qui c fait boloss hahahahaha"; break;
		case 1: mes "Mais non " + (Sex?"il":"elle") + " a marché " + (Sex?"le con":"la conne") + " °°"; break;
		case 2: mes "Aboule le fric et prend ta merde"; break;
		}

		// Retire les zeny
		Zeny -= 1000000000;
		// Donne 1 Moonlight Coin + log
		getitem Moonlight_Coin, 1;
		logmes "Vient d'acheter un Moonlight Coin"; // Logmes renseigne automatiquement le nom du joueur et le nom de npc dans la DB
		next;
		mes "[Chien des Bois]";
		switch( rand(3) ) {
		// Message d'au revoir
		case 0: mes "Azy maintenant casse toi !"; break;
		case 1: mes "Mais bouges de la wai !"; break;
		case 2: mes "Déblaye tu vas attiré les problèmes !"; break;
		}
	}
	else {
		// Message pas assez de zeny
		mes "Elle est ou la thune";
		sleep2 200;
		mes "ta voulu m'arnaqué hein";
		sleep2 500;
		mes "Dégage de la, saleté";
	}
	callsub Sub_IsSTN;
	close;
///////////////////////////////////////////////////////////////////////////
// Mode STN, cc STN <3
///////////////////////////////////////////////////////////////////////////
Sub_IsSTN:

	// check juste son sinX jsuis gentil x)
	// Stingor -> on va pas se priver de la joie de voir un STN se faire défoncer par un chien des bois
	// sur tous ses persos
	if (getuniqueid(getcharid(3)) == 11) {
		// Message d'amour
		switch( rand(3) ) {
		case 0:
			sleep2 500;
			mes "";
			mes "~ Chien des Bois fait ^FFFF00pipi^000000 sur " + strcharinfo(0) + " ~";
			close;
		case 1:
			sleep2 500;
			mes "";
			mes "~ ^FF00CC<3^000000 Chien des Bois monte la jambe de " + strcharinfo(0) + " ^FF00CC<3^000000 ~";
			close;
		case 2:
			close2;
			sleep2 200;
			atcommand "@nuke " + strcharinfo(0);
		}
		// Signature
		sleep2 200;
		mes "[Spider]";
		mes "Mouahahahaha";
		sleep2 500;
		mes "<3";
		atcommand "@nuke " + strcharinfo(0);
	}
	return;
}


///////////////////////////////////////////////////////////////////////////
//																		 //
//								NPC 2									 //
//																		 //
///////////////////////////////////////////////////////////////////////////


gonryun,186,96,3	script	Collectionneur	10056,{
	// Message de bienvenue et proposition
	mes "[Collectionneur]";
	mes "Salutations Aventuri" + (Sex?"er":"ère") + ", je suis en quête de précieux " + mesitemlink(Moonlight_Coin) + ".";
	sleep2 200;
	mes "Je suis prêt à vous en acheter un pour ^FF00001.000.000.000^000000z.";
	sleep2 200;
	mes "Êtes-vous en possession d'un tel Artéfact ?";

	// Choix
	Menu "Je ne l'ai pas.",-, "J'ai la Relique !", MenuSellCoin;
	// Refus de l'échange + Message d'au revoir
	clear;
	mes  "[Collectionneur]";
	mes "Je comprend, au revoir très cher.";
	close;


///////////////////////////////////////////////////////////////////////////
// Echange accepté
///////////////////////////////////////////////////////////////////////////
MenuSellCoin:
	Clear;
	// Check Moonlight Coin dans l'inventaire
	if( countitem(Moonlight_Coin) > 0 ) { // Item présent
		if( (Zeny + 1000000000) <= MAX_ZENY ) { // Check max zeny
			// Message assez de place pour les zeny
			mes "[Collectionneur]";
			mes "Mon précieux *__*";
			sleep2 500;
			mes "Enfin, je voulais dire...";
			sleep2 500;
			mes "Prennez ces quelques sous et donnez moi immédiatement le " + mesitemlink(Moonlight_Coin) + " !";
			
			// Retire un Moonlight Coin + log
			delitem(Moonlight_Coin, 1);
			logmes "Vient de donner un Moonlight Coin au Collectionneur";
			// Donne les zeny + log
			Zeny += 1000000000;
			logmes "Vient d'encaisser 1 milliard après vente d'un Moonlight_Coin";
		}
		else{
			// Message trop de zeny sur soi
			mes "[Collectionneur]";
			mes "Il me semble que votre bourse est trop remplie, faites donc un peu de place my " + (Sex?"Lord":"Lady") + ".";
		}
	}
	else {
		// Message pas de zeny pour les filou !
		mes "~ Fumble critique ~";
		sleep2 500;
		mes "Jet de persuasion ^FF0000échoué^000000.";
		Next;
		
		//Message d'au revoir
		mes "[Collectionneur]";
		mes "Je suis à la recherche de collaborateurs sérieux.";
		sleep2 500;
		mes "Si vous n'avez pas ce qui m'interesse allez-vous-en, roturi" + (Sex?"er":"ère") + " !";

	}
	close;
}
