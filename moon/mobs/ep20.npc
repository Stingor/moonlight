jor_twice,43,331,5	script	White cat#nyar_warp	EP20_NPC_NYAR,{
	if (ep20_main < 34) {
		npctalk "Guruk Guruk...", "", bc_self;
		end;
	}
	npctalk "Why?", "", bc_self;
	if (select( "Please let me into the twig's nest.", "Wow" ) == 2) {
		npctalk "Meow~", "", bc_self;
		sleep 500;
		npctalk "Guruk Guruk...", "", bc_self;
		end;
	}
	warp "jor_twig",212,114;
	end;
OnInit:
	// [Stingor] navigation : teleportation de script declaree au generateur (sans effet en jeu)
	naviregisterwarp("nyar_to_twig", "jor_twig", 212, 114, 204);
	end;
}
