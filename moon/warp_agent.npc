L_fld_moc:
	if( WarpaDetail)
		switch( select("• Field 1 à 10:• Field 11 à 20:• Field 21:• Field 22:• ^e64c00Menu Précédent^000000") ) {
			case 1: WarpMenu("moc_fild01", "moc_fild02", "moc_fild03", "moc_fild04", "moc_fild05",
					 "moc_fild06", "moc_fild07", "moc_fild08", "moc_fild09", "moc_fild10"); goto L_fld_moc;
			case 2: WarpMenu("moc_fild11", "moc_fild12", "moc_fild13", "moc_fild14", "moc_fild15",
					 "moc_fild16", "moc_fild17", "moc_fild18", "moc_fild19", "moc_fild20"); goto L_fld_moc;
			case 3:
				if (rebirth_moc_edq < 4)
					warp_fct("moc_fild20", 349, 185);
				else if (rebirth_moc_edq > 3 && rebirth_moc_edq < 8 && countitem(7826) > 0)
					warp_fct("moc_fild21", 38, 193);
				else if (rebirth_moc_edq == 8 && countitem(7826) > 0 )
					warp_fct("moc_fild21", 38, 193);
				goto L_fld_moc;
			case 4:
				if (countitem(7826) > 0) 
					warp_fct("moc_fild22", 38, 193);
				else if (countitem(7826) < 1) {
					mes "[Continental Guard]";
					mes "Only members of the Continental Guards with Continental Guard Certificates are allowed to proceed beyond this point.";
					close;
				}
			default: goto L_Fields;
		}
	else {
		switch( select("• moc_fild01:• moc_fild02:• moc_fild03:• moc_fild04:• moc_fild05:• moc_fild06:• moc_fild07:• moc_fild08:• moc_fild09:• moc_fild10:• moc_fild11:• moc_fild12:• moc_fild13:• moc_fild14:• moc_fild15:• moc_fild16:• moc_fild17:• moc_fild18:• moc_fild19:• moc_fild20:• moc_fild21:• moc_fild22") ) {
			case 1:  warp_fct("moc_fild01");
			case 2:  warp_fct("moc_fild02");
			case 3:  warp_fct("moc_fild03");
			case 4:  warp_fct("moc_fild04");
			case 5:  warp_fct("moc_fild05");
			case 6:  warp_fct("moc_fild06");
			case 7:  warp_fct("moc_fild07");
			case 8:  warp_fct("moc_fild08");
			case 9:  warp_fct("moc_fild09");
			case 10: warp_fct("moc_fild10");
			case 11: warp_fct("moc_fild11");
			case 12: warp_fct("moc_fild12");
			case 13: warp_fct("moc_fild13");
			case 14: warp_fct("moc_fild14");
			case 15: warp_fct("moc_fild15");
			case 16: warp_fct("moc_fild16");
			case 17: warp_fct("moc_fild17");
			case 18: warp_fct("moc_fild18");
			case 19: warp_fct("moc_fild19");
			case 20: warp_fct("moc_fild20");
			case 21:
				if (rebirth_moc_edq < 4)
					warp_fct("moc_fild20", 349, 185);
				else if (rebirth_moc_edq > 3 && rebirth_moc_edq < 8 && countitem(7826) > 0)
					warp_fct("moc_fild21", 38, 193);
				else if (rebirth_moc_edq == 8 && countitem(7826) > 0 )
					warp_fct("moc_fild21", 38, 193);
				break;
			case 22: 
				if (countitem(7826) > 0) 
					warp_fct("moc_fild22", 38, 193);
				else if (countitem(7826) < 1) {
					mes "[Continental Guard]";
					mes "Only members of the Continental Guards with Continental Guard Certificates are allowed to proceed beyond this point.";
					close;
				}
				break;
		}
	}
	end;
