L_tha: 
	if( WarpaDetail) {
		switch( select("• Niveau 1 à 6:• Niveau 7 à 12:• Boss:• ^e64c00Menu Précédent^000000") ) {
			case 1:
	   WarpMenu("tha_t01,150,70",
				"tha_t02,150,130",
				"tha_t03,220,161",
				"tha_t04,60,143",
				"tha_t05,62,8",
				"tha_t06,207,9"); goto L_tha;
			case 2:
	   WarpMenu("tha_t07,30,166",
				"tha_t08,29,44",
				"tha_t09,87,146",
				"tha_t10",
				"tha_t11",
				"tha_t12"); goto L_tha;
			case 3:
				if( $@thana_summon >= 6 && $@thana_summon_name$ == "" ) {
					clear;
					mes .@npc_name$;
					mes "Thanatos est déjà mort.";
					mes $@thana_summon_name_$+" l'a tué à "+gettimestr("%H:%M:%S",21,$@thana_summon_time);
					close;
				}
				else {
					if( $@thana_summon_name$ != "" ) {
						if( $@thana_summon_name$ != strcharinfo(0)
							&& getcharid(1, $@thana_summon_name$) != 0
							&& getcharid(1) != 0
							&& getcharid(1, $@thana_summon_name$) == getcharid(1)
							&& $@thana_summon2 > 0) {
							clear;
							mes .@npc_name$;
							mes $@thana_summon_name$+" a commencé l'invocation.";
							close2;
							warp_fct("thana_boss", 142, 222);
							end;
						}
						else if( $@thana_summon_name$ != strcharinfo(0) && $@thana_summon2 > 0 ) {
							clear;
							mes .@npc_name$;
							mes $@thana_summon_name$+" invoque actuellement Thanatos, vous ne pouvez acceder à cet étage.";
							close;
						}
					}
				}
				warp_fct("thana_boss", 142, 222);
			default: goto L_Donjons;
		}
	}
	else {
		switch( select("• Niveau 1 (tha_t01):• Niveau 2 (tha_t02):• Niveau 3 (tha_t03):• Niveau 4 (tha_t04):• Niveau 5 (tha_t05):• Niveau 6 (tha_t06):• Niveau 7 (tha_t07):• Niveau 8 (tha_t08):• Niveau 9 (tha_t09):• Niveau 10 (tha_t10):• Niveau 11 (tha_t11):• Niveau 12 (tha_t12):Niveau Boss (thana_boss)") ) {
			case 1: warp_fct("tha_t01", 150, 70);
			case 2: warp_fct("tha_t02", 150, 130);
			case 3: warp_fct("tha_t03", 220, 161);
			case 4: warp_fct("tha_t04", 60, 143);
			case 5: warp_fct("tha_t05", 62, 8);
			case 6: warp_fct("tha_t06", 207, 9);
			case 7: warp_fct("tha_t07", 30, 166);
			case 8: warp_fct("tha_t08", 29, 44);
			case 9: warp_fct("tha_t09", 87, 146);
			case 10:warp_fct("tha_t10");
			case 11:warp_fct("tha_t11");
			case 12:warp_fct("tha_t12");
			case 13:
				if( $@thana_summon >= 6 && $@thana_summon_name$ == "" ) {
					clear;
					mes .@npc_name$;
					mes "Thanatos est déjà mort.";
					mes $@thana_summon_name_$+" l'a tué à "+gettimestr("%H:%M:%S",21,$@thana_summon_time);
					close;
				}
				else {
					if( $@thana_summon_name$ != "" ) {
						if( $@thana_summon_name$ != strcharinfo(0)
							&& getcharid(1, $@thana_summon_name$) != 0
							&& getcharid(1) != 0
							&& getcharid(1, $@thana_summon_name$) == getcharid(1)
							&& $@thana_summon2 > 0) {
							clear;
							mes .@npc_name$;
							mes $@thana_summon_name$+" a commencé l'invocation.";
							close2;
							warp_fct("thana_boss", 142, 222);
							end;
						}
						else if( $@thana_summon_name$ != strcharinfo(0) && $@thana_summon2 > 0 ) {
							clear;
							mes .@npc_name$;
							mes $@thana_summon_name$+" invoque actuellement Thanatos, vous ne pouvez acceder à cet étage.";
							close;
						}
					}
				}
				warp_fct("thana_boss", 142, 222);
		}
	}
end;
