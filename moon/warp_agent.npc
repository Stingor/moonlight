function GetColor {
	return ((checkquest(getarg(0),PLAYTIME) == 2 || checkquest(getarg(0),PLAYTIME) == -1)?"^000000":"^FF0000");
}

function GetMobs {
	.@mobtotal = 0;
	.@moblvl = 0;
	.@rate = 0;
	deletearray .@mobids[0],getarraysize(.@mobids);
	deletearray .@mobnums[0],getarraysize(.@mobnums);
	getmapspawns(getarg(0));
	if (.@mobtotal) {
		mes "- ^51a1f3" + getmapname(getarg(0)) + " ("+getarg(0)+")^000000 - " + .@mobtotal + " monstres :";
		for(.@i = 0; .@i < getarraysize(.@mobids); .@i++) {
			.@bexp$ = getmonsterexprate(.@mobids[.@i], 0);
			.@jexp$ = getmonsterexprate(.@mobids[.@i], 1);
			if( .@bexp$ != "" && .@jexp$ != "" )
				.@exp$ = " EXP:"+.@bexp$+"/"+.@jexp$;
			else if( .@bexp$ != "" )
				.@exp$ = " EXP:"+.@bexp$;
			else
				.@exp$ = "";
			.@mobnum$ = "["+.@mobnums[.@i] + "]";
			if( bourgeon_ui(BOURGEON_UI_NPC_DIALOG)) {
				.@moblvexp$ = " (LV:" + getmonsterinfo(.@mobids[.@i], MOB_LV) + .@exp$ +")";
				if( getmonsterinfo(.@mobids[.@i], MOB_MODE) & MD_MVP || getmonsterinfo(.@mobids[.@i], MOB_MVPEXP) > 0 || getmonsterinfo(.@mobids[.@i], MOB_CLASS) == CLASS_BOSS )
					mes .@mobnum$ + mobsprite(.@mobids[.@i]) + mesmoblink(.@mobids[.@i]) + .@moblvexp$;
				else
					mes .@mobnum$ + mesmoblink(.@mobids[.@i]) + .@moblvexp$;
			}
			else {
				.@moblvexp$ = " (LV:" + .@moblv + .@exp$ + " ID: " + .@mobids[.@i] + ")";
				if( getmonsterinfo(.@mobids[.@i], MOB_MODE) & MD_MVP || getmonsterinfo(.@mobids[.@i], MOB_MVPEXP) > 0 )
					mes .@mobnum$ + " ^i[1]" + getmonsterinfo(.@mobids[.@i], MOB_NAME) + .@moblvexp$;
				else if( getmonsterinfo(.@mobids[.@i], MOB_CLASS) == CLASS_BOSS )
					mes .@mobnum$ + " ^i[2]" + getmonsterinfo(.@mobids[.@i], MOB_NAME) + .@moblvexp$;
				else
					mes .@mobnum$ + getmonsterinfo(.@mobids[.@i], MOB_NAME) + .@moblvexp$;
			}
		}
	}
	else {
		mes "- ^51a1f3" + getmapname(getarg(0)) + "^000000 - ne contient aucun mob.";
		setdialogsize(200,100);
		return;
	}
}

// ARG0..N = map names ; builds a menu with getmapname, calls warp_fct on selection
// Returns without warping when "Menu Précédent" is chosen.
function WarpMenu {
	.@n = getargcount();

	// Phase 1 : collecte spawns et LV moyen
	for (.@i = 0; .@i < .@n; .@i++) {
		explode(.@tmp$[0], getarg(.@i), ",");
		.@mname$[.@i] = .@tmp$[0];
		.@mxcoord[.@i] = atoi(.@tmp$[1]);
		.@mycoord[.@i] = atoi(.@tmp$[2]);
		deletearray .@mobids[0], getarraysize(.@mobids);
		deletearray .@mobnums[0], getarraysize(.@mobnums);
		.@mobtotal = 0;
		getmapspawns(.@mname$[.@i]);
		if (.@mobtotal > 0) {
			.@lvsum = 0;
			for (.@j = 0; .@j < getarraysize(.@mobids); .@j++)
				.@lvsum += getmonsterinfo(.@mobids[.@j], MOB_LV) * .@mobnums[.@j];
			.@avglv[.@i] = .@lvsum / .@mobtotal;
		}
	}

	// Phase 2 : construction menu et affichage detail
	.@sel$ = "";
	@mesnpctotal = 0;
	if (WarpaDetail) clear;
	for (.@i = 0; .@i < .@n; .@i++) {
		if (.@i > 0) .@sel$ += ":";
		.@avglv$ = .@avglv[.@i] > 0 ? " ~LV" + .@avglv[.@i] : "";
		.@sel$ += "• " + getmapname(.@mname$[.@i]) + " (" + .@mname$[.@i] + ")" + .@avglv$;
		if (WarpaDetail) GetMobs(.@mname$[.@i]);
	}
	if (WarpaDetail) setdialogsize(500,10+cap_value(25*.@mesnpccount,150,600));
	.@c = select(.@sel$ + ":• ^e64c00Menu Précédent^000000") - 1;
	if (.@c < .@n) {
		if (.@mxcoord[.@c] > 0 && .@mycoord[.@c] > 0)
			warp_fct(.@mname$[.@c], .@mxcoord[.@c], .@mycoord[.@c]);
		else
			warp_fct(.@mname$[.@c]);
	}
	return;
}
Hard_Mode:
	if( is_party_leader(getcharid(1)) == true && (getgroupid() == 99 || getarg(0) != "^FF0000") ) {
		clear;
		mes .@npc_name$;
		mes "Cette instance est disponible avec plusieur niveau de difficulté, êtes vous prêts à tenter?";
		setdialogsize(300,200);
		return select( "Facile(1)", "Normal(2)", "Moyen(3)", "", "Difficile(5)", "", "Très Difficile (7)", "", "", "MALADE (10)" );
	}
	return 1;

Turbo_Mode:
	if( is_party_leader(getcharid(1)) == true && (getgroupid() == 99 || getarg(0) != "^FF0000") ) {
		clear;
		mes .@npc_name$;
		mes "Cette instance est disponible avec le mode turbo.";
		mes "^FF0000Attention!!";
		mes "une fois activé vous sauterez la plupart des dialogues!!^000000";
		if( select( "Mode turbo OFF", "Mode turbo ON" ) == 2 )
			return 1;
	}
	return 0;
	
Party_Check: // Check si une party existe bien
	if( instance_check_party(getcharid(1), 1) == 0 ) {
		clear;
		mes .@npc_name$;
		mes "^0000ff"+getarg(0)+"^000000 - Problème de party";
		mes "Faites une party.";
		close;
	}
	return;

Leader_Check: // Pour instance Solo
	if( is_party_leader(getcharid(1)) == false ) {
		clear;
		mes .@npc_name$;
		mes "^ff0000Cette instance est à faire seul. Seul le party leader peut entrer.^000000";
		close;
	}
	return;

Create_Instance: // Création instance
	.@hardmode = getarg(1,1);
	if( .@hardmode < 1 )
		.@hardmode = 1;
	.@turbo = getarg(2,0);
	if( .@turbo < 1 )
		.@turbo = 0;
	if( is_party_leader(getcharid(1)) == true ) {
		if( instance_create(getarg(0), IM_PARTY, getcharid(1), .@hardmode, .@turbo) < 1 ) {
			clear;
			mes .@npc_name$;
			mes "Party name: " + getpartyname(getcharid(1));
			mes "Character name: " + strcharinfo(0);
			mes "^0000ff" + getarg(0) + "^000000 - Création echouée!";
			close;
		}
		else {
			if( .@hardmode > 1 )
				logmes "Création de l'instance: " + getarg(0) + " niveau " + .@hardmode;
			else
				logmes "Création de l'instance: " + getarg(0);
		}
	}
	return;

Quick_Enter:
	if ( BaseLevel < 100 ) {
		mes .@npc_name$;
		mes "Vous venez être au moins niveau 100 pour entrer cette instance!";
		close;
	} 
	switch( instance_enter(getarg(0)) ) {
		case IE_NOMEMBER:
		case IE_NOINSTANCE:
		case IE_OTHER:
			break;
		case IE_OK:
			end;
	}
	clear;
	mes .@npc_name$;
	mes "^ff0000Le timer de cette instance expire à 4h du matin.^000000";
	next;
	goto L_Instance;

Process_Instance:
	if( checkquest(getarg(3), PLAYTIME) == 2 )
		erasequest getarg(3); // Reset de la quest cooldown
	if( getgroupid() == 99 ) {
		if( select("bypassgm?", "non") == 1 )
		{
			callsub Create_Instance, getarg(0), getarg(1), getarg(2,0); // Création instance
			if( getarg(3,0) != 0 && isbegin_quest(getarg(3,0)))
				erasequest getarg(3);
			if( getarg(4,0) != 0 && isbegin_quest(getarg(4,0)))
				erasequest getarg(4);
			switch( instance_enter(getarg(0)) ) {
				case IE_NOMEMBER: goto L_NOMEMBER;
				case IE_NOINSTANCE: goto L_NOINSTANCE;
				case IE_OTHER: goto L_OTHER;
				case IE_OK:
					if( getarg(4,0) != 0) {
						if( isbegin_quest(getarg(4)) == 0 )
							setquest getarg(4); // Set de la quest bonus
					}
					setquest getarg(3); // Set de la quest cooldown
					end;
			}
			end;
		}
	}
	switch( checkquest(getarg(3), PLAYTIME) ) {
		case -1:
			clear;
			mes .@npc_name$;
			mes "^ff0000Si vous mourrez ou sortez vous ne pourrez plus entrer de nouveau.^000000";
			if( select("-:Ok:-") == 2 ) next;
			else close;
			callsub Create_Instance, getarg(0), getarg(1); // Création instance
			if ( BaseLevel < 100 ) {
				mes .@npc_name$;
				mes "Vous venez être au moins niveau 100 pour entrer cette instance!";
				close;
			} 
			switch( instance_enter(getarg(0)) ) {
				case IE_NOMEMBER: goto L_NOMEMBER;
				case IE_NOINSTANCE: goto L_NOINSTANCE;
				case IE_OTHER: goto L_OTHER;
				case IE_OK:
					if( getarg(4,0) != 0) {
						if( isbegin_quest(getarg(4)) == 0 )
							setquest getarg(4); // Set de la quest bonus
					}
					setquest getarg(3); // Set de la quest cooldown
					end;
			}
			end;
		case 0:
		case INST_ASSAULT_ON_THE_AIRSHIP:
			// if( is_party_leader(getcharid(1)) == true )
				// callsub Quick_Enter,getarg(0); end;
		case INST_BAKONAWA_LAKE:
			clear;
			mes .@npc_name$;
			mes "^ff0000Vous devez attendre le reset de votre instance.^000000";
			close;
	}
	end;

L_NOMEMBER:
	clear;
	mes .@npc_name$;
	mes "^ff0000Vous n'avez plus de party ?^000000";
	close;
L_NOINSTANCE:
	clear;
	mes .@npc_name$;
	mes "^ff0000L'instance ne semble pas être générée.^000000";
	close;
L_OTHER:
	clear;
	mes .@npc_name$;
	mes "Une erreur est survenue.";
	close;

L_Autre:
	clear;
	mes .@npc_name$;
	mes "Sélectionnez la destination de votre choix :";
	switch( select("• Forge:• Shop armement:• Eden Group:• Flame Bassin:• Mid Camp:• Seals:• Yggdrasil:• Rebellion Base:• ^e64c00Menu Précédent.^000000") ) {
		case 1: warp_fct("gon_in", 94, 21);
		case 2: warp_fct("gon_in", 163, 23);
		case 3: warp_fct("moc_para01", 31, 14);
		case 4: warp_fct("moro_vol");
		case 5: warp_fct("mid_camp", 220, 235);
		case 6: warp_fct("cmd_fild02", 193, 169);
		case 7: warp_fct("yggdrasil01", 52, 63);
        case 8:
            if (terra_gloria_main > 14)
                warp_fct("rebel_in", 40,43);
            else{
                mes "You don't have access to the Rebellion Base.";
                close;
            }
		default: goto L_warpa;
	}
	end;

