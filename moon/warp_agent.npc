L_Rooms:
	clear;
	mes .@npc_name$;
	mes "Sélectionnez la salle de votre choix :";
	switch( select("• Carnage Room [ ^FF0000"+getmapusers("pvp_n_3-5")+"^000000 joueur(s) ]:• PvP Room [ ^FF0000"+getmapusers("pvp_n_4-1")+"^000000 joueur(s) ]:• Duel Room [ ^FF0000"+getmapusers("pvp_n_2-1")+"^000000 joueur(s) ]:• GvG Room [ ^FF0000"+getmapusers("pvp_n_5-1")+"^000000 joueur(s) ]:• DB Room [ ^FF0000"+getmapusers("pvp_n_1-1")+"^000000 joueur(s) ]:• BB Room [ ^FF0000"+getmapusers("pvp_n_3-1")+"^000000 joueur(s) ]:• Test Room [ ^FF0000"+getmapusers("pvp_n_5-5")+"^000000 joueur(s) ]:• ^e64c00Menu Précédent.^000000") ) {
		case INST_ASSAULT_ON_THE_AIRSHIP:	// Carnage Room
			callsub Check_Buffs;
			warp_fct("pvp_n_3-5");
			break;
		case INST_BAKONAWA_LAKE:	// PvP Room
			clear;
			mes .@npc_name$;
			mes "N'oubliez-pas que dans cette salle, battez vous de façon loyal...";
			mes "Freekill interdit et punissable.";
			mes "Fairplay oblige.";
			if( select("Entrer en PvP Room", "Non merci,j'ai peur.") == 1 ) {
				callsub Check_Buffs;
				warp_fct("pvp_n_4-1", 105, 71);
				end;
			}
			else
				goto L_warpa;
			break;
		case INST_BANGUNGOT_HOSPITAL_2F:	// Duel Room
			warp_fct("pvp_n_2-1", 105, 71);
			break;
		case INST_BUWAYA_CAVE:	// GvG Room
			clear;
			mes .@npc_name$;
			mes "N'oubliez-pas que dans cette salle, battez vous de façon loyal...";
			mes "Freekill interdit et punissable.";
			mes "Fairplay oblige.";
			if( select("Entrer en GvG Room", "Non merci,j'ai peur.") == 1 ) {
				callsub Check_Buffs;
				warp_fct("pvp_n_5-1", 105, 64);
				end;
			}
			else
				goto L_warpa;
			break;
		case 5: warp_fct("pvp_n_1-1", 104, 71);	// DB room
		case 6: warp_fct("pvp_n_3-1", 104, 71);	// BB room
		case 7: warp_fct("pvp_n_5-5");		// Test Room
		default: goto L_warpa;
	}
	end;

Check_Buffs:
	if( getstatus(SC_CP_WEAPON) || getstatus(SC_CP_ARMOR) || getstatus(SC_CP_SHIELD) || getstatus(SC_CP_HELM) || getstatus(SC_SPIRIT) ) {
		next;
		mes .@npc_name$;
		mes "Vous êtes sur le point d'entrer en pvp avec une protection d'Alchemist et/ou un boost Soul Linker.";
		mes "Vous allez être dispell de ce buff, êtes vous certain de vouloir rentrer ?";
		if( select("Non:Oui") == 1 )
			close;
		close2;
		sc_end SC_CP_WEAPON;
		sc_end SC_CP_ARMOR;
		sc_end SC_CP_SHIELD;
		sc_end SC_CP_HELM;
		sc_end SC_SPIRIT;
	}
	return;

L_Save:
	clear;
L_SaveCmd:
	mes .@npc_name$;
	atcommand "@save";
	mes "Ton point de sauvegarde est à présent à l'endroit où tu es placé.";
	mes "Bon jeu !";
	close;

OnInit:
	// [navi] destinations du Warp Agent ---------------------------------------
	// naviregisterwarp ne fait rien hors map-server-generator : ce bloc est
	// inerte en production, il ne sert qu'a la generation des .lub client.
	//
	// Le type 204 ("service Kafra" cote client) est le coeur de l'affaire.
	// Le pathfinder du client filtre chaque arete sur son type et REFUSE les
	// 204 tant que l'option d'itineraire correspondante est eteinte. Le graphe
	// pedestre reste donc intact -- sans quoi le Warp Agent, qui dessert tout
	// depuis 38 endroits, ramenerait n'importe quel trajet a un saut unique et
	// la navigation ne dirait plus rien. Avec l'option, l'itineraire devient
	// "parle au Warp Agent, prends telle ville, puis marche".
	//
	// Le 5e champ d'un Navi_Link est ce que le client AFFICHE ("Talk to ...").
	// Laisse vide, le generateur y met <source>_<destination>_<id> : unique, mais
	// illisible pour un joueur -- et l'unicite est deja portee par l'id du lien,
	// pas par ce champ (le 6e, "unique name", reste vide de toute facon).
	// strnpcinfo(1) rend le nom AFFICHE du PNJ, donc l'etiquette suit un
	// renommage du Warp Agent sans qu'on ait a y revenir.
	//
	// Une destination en (0, 0) n'est pas une erreur : c'est le raccourci
	// "n'importe ou sur cette carte", tel que l'ecrit deja WarpMenu quand il
	// n'a pas de coordonnees. naviregisterwarp le resout en une cellule
	// PRATICABLE (map_search_freecell), sans quoi le generateur produirait un
	// lien qu'aucun chemin n'atteint -- il lance son A* DEPUIS la destination,
	// et la cellule (0, 0) est le bord de la carte.
	//
	// Genere depuis les menus de ce meme fichier par
	// scratchpad/gen_navi_warpagent.py -- reexecuter si les menus changent.
	setarray .@navm$[0],
		"gonryun", "alberta", "aldebaran", "amatsu",
		"ayothaya", "brasilis", "comodo", "dewata",
		"dicastes01", "eclage", "einbech", "einbroch",
		"geffen", "hugel", "izlude", "jawaii",
		"lasagna", "lighthalzen", "louyang", "xmas";
