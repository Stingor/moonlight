//===== Moonlight-Destiny ====================================
//= Script warp agent.
//============================================================

gonryun,165,129,3	script	Warp Agent::warp_agent	4_F_01,{
	function GetColor;
	function GetMobs;
	function WarpMenu;
	.@npc_name$ = "[ ^1F81D4"+strnpcinfo(0)+"^000000 ]";
L_WarpaCmd:
	mes .@npc_name$;
	mes "Bonjour ^4a8b3e" + strcharinfo(0) + "^000000 !";
	mes "Je suis le Npc qui sert à se teleporter dans les villes et les donjons ainsi que de sauvegarder !";
	setdialogsize(300,50*.@mesnpccount);
L_warpa:
	if( lastm_warpa$ == "" && lastx_warpa == 0 && lasty_warpa == 0 )
		@lastwarp$ = "";
	else
		@lastwarp$ = "• ^51a1f3" + getmapname(lastm_warpa$) + "^000000";

	if( !getmapxy(.@map$, .@mapx, .@mapy) ) {
		if( getsavepoint(0) == .@map$ && getsavepoint(1) == .@mapx && getsavepoint(2) == .@mapy )
			.@save$ = "";
		else
			.@save$ = "• ^805bdfSauvegarder^000000";
	}
	else .@save$ = "";

	menu @lastwarp$, -,
		($eventinvasion ? "Invasion" : ""), L_Invasion,
		"• ^5ca57bVilles^000000", L_Villes,
		"• ^f28e0dDonjons^000000", L_Donjons,
		"• ^d28efdFields^000000", L_Fields,
		"• ^f08eddGuild Dungeons^000000",L_Guild_Dungeons,
		"• ^f08eedInstances^000000", L_Instance,
		"• ^c08dedAutre^000000", L_Autre,
		"• ^f279acRooms^000000", L_Rooms,
		"• ^3655ffDétail des maps^000000 ("+(WarpaDetail?"^20ff1fON":"^ff0000OFF")+"^000000)", L_Option,
		.@save$, L_Save;
	warp_fct(lastm_warpa$, lastx_warpa, lasty_warpa);
	end;
L_Option:
	WarpaDetail = !WarpaDetail;
	goto L_warpa;
L_Invasion:
	warp_fct($mapinvasion$);
	end;
L_Villes:
	clear;
L_VillesCmd:
	mes .@npc_name$;
	mes "Sélectionnez la destination de votre choix :";
	setdialogsize(300,50*.@mesnpccount);
	// Ajouter une ville: une valeur par tableau + l'entrée dans .@vn$
	setarray .@vn$[0],
		"^ff0000• Gonryun^000000", "• Alberta",     "• Aldebaran",   "• Amatsu",
		"• Ayothaya",              "• Brasilis",     "• Comodo",      "• Dewata",
		"• Dicastes",              "• Eclage",       "• Einbech",     "• Einbroch",
		"• Geffen",                "• Hugel",        "• Izlude",      "• Jawaii",
		"• Lasagna",               "• Lighthalzen",  "• Louyang",     "• Lutie",
		"• Malangdo",              "• Malaya",       "• Manuk",       "• Mora",
		"• Morocc",                "• Moscovia",     "• Niflheim",    "• Payon",
		"• Prontera",              "• Rachel",       "• Rock Ridge",  "• Splendide",
		"• Umbala",                "• Veins",        "• Juno";
	setarray .@vm$[0],
		"gonryun",    "alberta",    "aldebaran", "amatsu",
		"ayothaya",   "brasilis",   "comodo",    "dewata",
		"dicastes01", "eclage",     "einbech",   "einbroch",
		"geffen",     "hugel",      "izlude",    "jawaii",
		"lasagna",    "lighthalzen","louyang",   "xmas",
		"malangdo",   "malaya",     "manuk",     "mora",
		"morocc",     "moscovia",   "niflheim",  "payon",
		"prontera",   "rachel",     "harboro1",  "splendide",
		"umbala",     "veins",      "yuno";
	setarray .@vx[0],
		156,  50, 140, 200, 207, 195, 166, 200,
		197, 167, 170,  65, 120,  96, 128, 135,
		193, 158, 218, 148, 167, 144, 286, 136,
		158, 224, 194, 177, 155, 128, 283, 200,
		122, 196, 153;
	setarray .@vy[0],
		120, 240, 117, 110, 192, 215, 161, 174,
		223, 194, 125, 200,  68, 145, 111, 202,
		182,  92, 115, 131, 136, 240, 230,  91,
		 93, 192, 186, 104, 182, 111, 212, 149,
		138, 230, 123;
	.@n = getarraysize(.@vn$);
	.@sel$ = "";
	for (.@i = 0; .@i < .@n; .@i++)
		.@sel$ = .@sel$ + (.@i > 0 ? ":" : "") + .@vn$[.@i];
	.@c = select(.@sel$ + ":• ^e64c00Menu Précédent.^000000") - 1;
	if (.@c >= .@n) goto L_warpa;
	if (.@c == 0)
		warp_fct("gonryun", 156 + rand(1,5), 120 + rand(1,4));
	else
		warp_fct(.@vm$[.@c], .@vx[.@c], .@vy[.@c]);
	end;

L_Guild_Dungeons:
	clear;
	mes .@npc_name$;
	mes "Sélectionnez la destination de votre choix :";
	setdialogsize(300,50*.@mesnpccount);
	// Ajouter un guild dungeon: une valeur par tableau + l'entrée dans .@gn$
	setarray .@gn$[0],
		"• Corridor of the Abyss - Tears of Hero",
		"• Corridor of the Abyss - Dead Man Hill",
		"• Corridor of the Abyss - Ancient Wind",
		"• Corridor of the Abyss - Warrior's Way",
		"• Greenwood Lake Guild Dungeon 1",
		"• Greenwood Lake Guild Dungeon 2",
		"• Luina Guild Dungeon 1",
		"• Luina Guild Dungeon 2",
		"• Valkyrie Guild Dungeon 1",
		"• Valkyrie Guild Dungeon 2",
		"• Britoniah Guild Dungeon 1",
		"• Britoniah Guild Dungeon 2",
		"• Arunafeltz Guild Dungeon",
		"• Schwartzvald Guild Dungeon",
		"• TE Subterranean Guild Dungeon 1",
		"• TE Subterranean Guild Dungeon 2";
	setarray .@gm$[0],
		"gld2_ald",   "gld2_gef",   "gld2_pay",   "gld2_prt",
		"gld_dun01",  "gld_dun01_2","gld_dun02",  "gld_dun02_2",
		"gld_dun03",  "gld_dun03_2","gld_dun04",  "gld_dun04_2",
		"arug_dun01", "schg_dun01", "teg_dun01",  "teg_dun02";
	setarray .@gx[0],
		147, 152, 120, 140,
		119, 119,  39,  39,
		 50,  50, 116, 116,
		199, 200,  42,  26;
	setarray .@gy[0],
		155, 118, 130, 132,
		 93,  93, 161, 161,
		 44,  44,  45,  45,
		195, 124,  36, 160;
	.@n = getarraysize(.@gn$);
	.@sel$ = "";
	for (.@i = 0; .@i < .@n; .@i++)
		.@sel$ = .@sel$ + (.@i > 0 ? ":" : "") + .@gn$[.@i];
	.@c = select(.@sel$ + ":• ^e64c00Menu Précédent.^000000") - 1;
	if (.@c >= .@n) goto L_warpa;
	if ( WarpaDetail) {
		WarpMenu(.@gm$[.@c]);
		goto L_Guild_Dungeons; // Menu Précédent
	}
	else warp_fct(.@gm$[.@c], .@gx[.@c], .@gy[.@c]);
	end;

L_Instance:
	clear;
	.@hardmode = 1;
	.@party_id = getcharid(1);
	if( .@party_id < 1 ) {
		party_create("party" + gettimetick(0));
		mes .@npc_name$;
		mes "Party genérée...";
		mes "Attention, il n'est pas possible de retourner dans une instance une fois que vous l'avez quittée.";
		setdialogsize(300,50*.@mesnpccount);
		next;
	}
	mes .@npc_name$;
	mes "Sélectionnez la destination de votre choix :";
	setdialogsize(300,50*.@mesnpccount);
	// Liste des instances : l'ordre ci-dessous est celui du menu et peut changer
	// librement, l'identite de chaque instance etant portee par sa constante
	// INST_* (generee depuis instance_db.yml par tools/gen/gen_instance_constants.py).
	// Ajouter une instance = une entree dans les trois tableaux + un case, sans
	// jamais renumeroter quoi que ce soit.
	setarray .@lbl$[0],
					"Airship Assault (Solo & HM)",
					"Bakonawa Lake",
					"Bangungot Hospital 2F (HM)",
					"Buwaya Cave (HM)",
					"Central Laboratory",
					"Charleston in Distess",
					"Devil's Tower",
					"Endless Cellar (HM, Custom)",
					"Endless Tower (HM)",
					"Faceworms Nest (Solo)",
					"Gef. Magic Tour. (HM, Solo, Custom)",
					"Ghost Palace (Solo)",
					"Hazy Forest",
					"Horror Toy Factory (HM)",
					"Infinite Space (HM sur place)",
					"Isle Of Bios",
					"Last Room",
					"Malangdo Culvert",
					"Morse Cave",
					"Nightmarish Jitterbug (HM)",
					"Nydhoggur's Nest",
					"Octopus Cave",
					"Old Glast Heim (HM)",
					"Orc's Memory",
					"Room of Consciousness (HM, Solo)",
					"Sarah and Fenrir",
					"Sara Memory",
					"Sealed Shrine",
					"Temple of Demon God",
					"Wolfchev's Laboratory";
	setarray .@inst[0],
					INST_ASSAULT_ON_THE_AIRSHIP,
					INST_BAKONAWA_LAKE,
					INST_BANGUNGOT_HOSPITAL_2F,
					INST_BUWAYA_CAVE,
					INST_CENTRAL_LABORATORY,
					INST_CHARLESTON_IN_DISTRESS,
					INST_DEVILS_TOWER,
					INST_ENDLESS_CELLAR,
					INST_ENDLESS_TOWER,
					INST_FACEWORMS_NEST,
					INST_GEFFEN_MAGIC_TOURNAMENT,
					INST_GHOST_PALACE,
					INST_MISTWOOD_MAZE,
					INST_HORROR_TOY_FACTORY,
					INST_INFINITE_SPACE,
					INST_ISLE_OF_BIOS,
					INST_LAST_ROOM,
					INST_CULVERT,
					INST_MORSES_CAVE,
					INST_NIGHTMARISH_JITTERBUG,
					INST_NIDHOGGURS_NEST,
					INST_OCTOPUS_CAVE,
					INST_OLD_GLAST_HEIM,
					INST_ORCS_MEMORY,
					INST_ROOM_OF_CONSCIOUSNESS,
					INST_FENRIR_AND_SARAH,
					INST_SARAS_MEMORIES,
					INST_SEALED_CATACOMB,
					INST_TEMPLE_OF_THE_DEMON_GOD,
					INST_WOLFCHEVS_LABORATORY;
	// quete de cooldown utilisee pour la couleur ; 0 = cas particulier traite plus bas
	setarray .@cd[0],
					15050, // INST_ASSAULT_ON_THE_AIRSHIP
					12278, // INST_BAKONAWA_LAKE
					9223,  // INST_BANGUNGOT_HOSPITAL_2F
					4229,  // INST_BUWAYA_CAVE
					12347, // INST_CENTRAL_LABORATORY
					13185, // INST_CHARLESTON_IN_DISTRESS
					7577,  // INST_DEVILS_TOWER
					0,     // INST_ENDLESS_CELLAR
					60200, // INST_ENDLESS_TOWER
					12325, // INST_FACEWORMS_NEST
					9316,  // INST_GEFFEN_MAGIC_TOURNAMENT
					1261,  // INST_GHOST_PALACE
					7211,  // INST_MISTWOOD_MAZE
					12331, // INST_HORROR_TOY_FACTORY
					12365, // INST_INFINITE_SPACE
					15005, // INST_ISLE_OF_BIOS
					11379, // INST_LAST_ROOM
					12254, // INST_CULVERT
					9319,  // INST_MORSES_CAVE
					13182, // INST_NIGHTMARISH_JITTERBUG
					3135,  // INST_NIDHOGGURS_NEST
					4197,  // INST_OCTOPUS_CAVE
					12317, // INST_OLD_GLAST_HEIM
					12059, // INST_ORCS_MEMORY
					7706,  // INST_ROOM_OF_CONSCIOUSNESS
					9336,  // INST_FENRIR_AND_SARAH
					15002, // INST_SARAS_MEMORIES
					3040,  // INST_SEALED_CATACOMB
					7605,  // INST_TEMPLE_OF_THE_DEMON_GOD
					5112;  // INST_WOLFCHEVS_LABORATORY

	.@n = getarraysize(.@inst);
	.@menu$ = "";
	for ( .@i = 0; .@i < .@n; .@i++ ) {
		if ( .@cd[.@i] == 0 )
			.@col$ = ( instance_delay_cellar < gettimetick(2) ? "^000000" : "^FF0000" );
		else
			.@col$ = GetColor(.@cd[.@i]);
		.@menu$ += .@col$ + "• " + .@lbl$[.@i] + "^000000:";
	}
	.@menu$ += "• ^e64c00Menu Précédent.^000000";

	.@sel = select(.@menu$);
	if ( .@sel > .@n )
		goto L_warpa;
	switch( .@inst[.@sel - 1] ) {
		case INST_ASSAULT_ON_THE_AIRSHIP: { // Airship Assault
			if( select( GetColor(15050)+"Acces direct^000000", "Se rendre dans le Rift" ) == 1 ) {
				.@md_name$ = "Assault on the Airship";
				.@questid = 15050; // Memorial Dungeon: Airship Assault
				callsub Party_Check,.@md_name$;
				callsub Leader_Check; // Pour instance Solo
				.@hardmode = callsub(Hard_Mode,GetColor(.@questid));
				.@turbo = callsub(Turbo_Mode,GetColor(.@questid));
				callsub Process_Instance,.@md_name$,.@hardmode,.@turbo,.@questid;
				break;
			}
			warp_fct("dali02", 139, 82);
		}
		case INST_BAKONAWA_LAKE: { // Bakonawa Lake
			if( select( GetColor(12278)+"Acces direct^000000", "Se rendre au lac" ) == 1 ) {
				.@md_name$ = "Bakonawa Lake";
				.@questid1 = 12278; // Towards Bakonawa Lake...
				.@questid2 = 12279; // Get Rid of Bakonawa
				if( isbegin_quest(.@questid2) > 1 )
					completequest .@questid2;
				callsub Party_Check,.@md_name$;
				callsub Process_Instance,.@md_name$,.@hardmode,.@turbo,.@questid1,.@questid2;
				break;
			}
			warp_fct("ma_scene01", 172, 175);
		}
		case INST_BANGUNGOT_HOSPITAL_2F: { // Bangungot Hospital
			if( select( GetColor(9223)+"Acces direct^000000", "Se rendre au 1er étage" ) == 1 ) {
				.@md_name$ = "Bangungot Hospital 2F";
				.@questid1 = 9223; // Will there be Peace at the Hospital?
				.@questid2 = 9222; // Get Rid of Bangungot from Hospital 2F
				if( isbegin_quest(.@questid2) > 1 )
					completequest .@questid2;
				callsub Party_Check,.@md_name$;
				.@hardmode = callsub(Hard_Mode,GetColor(.@questid1));
				callsub Process_Instance,.@md_name$,.@hardmode,.@turbo,.@questid1,.@questid2;
				break;
			}
			warp_fct("ma_dun01", 151, 8);
		}
		case INST_BUWAYA_CAVE:	{ // Buwaya Cave
			.@md_name$ = "Buwaya Cave";
			.@questid = 4229; // Devil in the Cave
			callsub Party_Check,.@md_name$;
			.@hardmode = callsub(Hard_Mode,GetColor(.@questid));
			callsub Process_Instance,.@md_name$,.@hardmode,.@turbo,.@questid;
			break;
			// warp_fct("ma_fild02", 316, 317);
		}
		case INST_CENTRAL_LABORATORY:	{ // Central Laboratory
			if( select( GetColor(12347)+"Acces direct^000000", "Se rendre sur place" ) == 1 ) {
				.@md_name$ = "Central Laboratory";
				.@questid1 = 12347; // Trace of Laboratory Access
				.@questid2 = 12346; // Strange Ancient Science
				if( isbegin_quest(.@questid2) == 1 )
					completequest .@questid2;
				callsub Party_Check,.@md_name$;
				callsub Process_Instance,.@md_name$,.@hardmode,.@turbo,.@questid1,.@questid2;
				break;
			}
			warp_fct("verus01", 151, 150);
		}
		case INST_CHARLESTON_IN_DISTRESS:	{ // Charleston in distress
L_Charleston:
			if( select( GetColor(13185)+"Acces direct^000000", "Se rendre sur place" ) == 1 ) {
				.@md_name$ = "Charleston in Distress";
				.@questid = 13185; // Charleston Factory - Hold

				if( checkquest(13186) > -1 ) {
					getexp 1800000,600000;
					if( isbegin_quest(13184) )
						erasequest 13184;
					erasequest 13186;
					mes .@npc_name$;
					mes "Vous venez de completer des quêtes!";
					next;
					goto L_Charleston;
				}

				callsub Party_Check,.@md_name$;
				callsub Process_Instance,.@md_name$,.@hardmode,.@turbo,.@questid;
				break;
			}
			warp_fct("verus04", 77, 118);
		}
		case INST_DEVILS_TOWER:	{ // Devil's Tower
L_DevilTower:
			if( select( GetColor(7577)+"Acces direct^000000", "Se rendre sur place" ) == 1 ) {
				.@md_name$ = "Devil's Tower";

				callsub Party_Check,.@md_name$;

				if( checkquest(7577,PLAYTIME) == 2 )
					erasequest 7577; // Space distortion

				if( isbegin_quest(7576) > 0 ) {// instance completed
					erasequest 7571;// Tower Expedition
					erasequest 7574;// Thanatos Tower
					erasequest 7576;// Morocc castle seal
					getexp 450000,450000;
					clear;
					mes .@npc_name$;
					mes "Vous venez de completer des quêtes!";
					next;
					goto L_DevilTower;
				}

				if( isbegin_quest(7574) > 0 ) { // failed after seal
					erasequest 7571;// Tower Expedition
					erasequest 7574;// Thanatos Tower
					getexp 300000,300000;
					clear;
					mes .@npc_name$;
					mes "Vous venez de completer des quêtes!";
					next;
					goto L_DevilTower;
				}

				if( isbegin_quest(7571) > 0 ) {// failed at stair 2 tnm1
					erasequest 7571;// Tower Expedition
					if (isbegin_quest(7572)) erasequest 7572;// Lucile...?
					if (isbegin_quest(7573)) erasequest 7573;// Magic Swordman Thanatos
					getexp 200000,200000;
					clear;
					mes .@npc_name$;
					mes "Vous venez de completer des quêtes!";
					next;
					goto L_DevilTower;
				}

				switch( checkquest(7577,PLAYTIME) ) {
					case -1:
						callsub Create_Instance,.@md_name$,.@hardmode; // Création instance
						if ( BaseLevel < 100 ) {
							mes .@npc_name$;
							mes "Vous venez être au moins niveau 100 pour entrer cette instance!";
							close;
						} 
						switch( instance_enter(.@md_name$) ) {
							case IE_NOMEMBER: goto L_NOMEMBER;
							case IE_NOINSTANCE: goto L_NOINSTANCE;
							case IE_OTHER: goto L_OTHER;
							case IE_OK:
								if (isbegin_quest(7569)) erasequest 7569;// Treat the injured
								if (isbegin_quest(7570)) erasequest 7570;// Destroy the demons
								setquest 7577; // Space distortion
								end;
						}
						end;
					case 0:
					case 1:
						callsub Quick_Enter,.@md_name$;
				}
				break;
			}
			warp_fct("dali02", 137, 115);
		}
		case INST_ENDLESS_CELLAR:	{ // Endless Cellar
			.@md_name$ = "Endless Cellar";
			.instance_delay = 20 * 60 * 60; // 20h
			callsub Party_Check,.@md_name$;
			if( is_party_leader(getcharid(1)) == true && instance_delay_cellar < gettimetick(2) ) {
				mes .@npc_name$;
				mes "Cette instance est disponible avec plusieur niveau de difficulté, êtes vous prêts à tenter?";
				mes "^FF0000Attention!!";
				mes "Le timer reste le même pour chaque niveau !! Si vous échouez au 5 vous ne pourrez changer la difficulté.^000000";
				setdialogsize(300,200);
				.@hardmode = select( "Facile(1)", "Normal(2)", "Moyen(3)", "", "Difficile(5)", "", "Très Difficile(7)", "", "", "MALADE(10)", "", "", "", "", "Mindblown(15)", "", "", "", "", "Game Over(20)" );
				callsub Create_Instance, .@md_name$, .@hardmode; // Création instance
			}
			if ( BaseLevel < 100 ) {
				mes .@npc_name$;
				mes "Vous venez être au moins niveau 100 pour entrer cette instance!";
				close;
			} 
			switch( instance_enter(.@md_name$) ) {
				case IE_NOMEMBER: goto L_NOMEMBER;
				case IE_NOINSTANCE: goto L_NOINSTANCE;
				case IE_OTHER: goto L_OTHER;
				case IE_OK:
					instance_delay_cellar = (gettimetick(2) + .instance_delay);
					end;
			}
			break;
			// warp_fct("e_tower", 78, 80);
		}
		case INST_ENDLESS_TOWER:	{ // Endless Tower
			.@md_name$ = "Endless Tower";
			.@questid = 60200; // Endless Tower Effect
			callsub Party_Check,.@md_name$;
			if( is_party_leader(getcharid(1)) == true && GetColor(.@questid) != "^FF0000" ) {
				mes .@npc_name$;
				mes "Cette instance est disponible avec plusieur niveau de difficulté, êtes vous prêts à tenter?";
				mes "^FF0000Attention!!";
				mes "Le timer reste le même pour chaque niveau !! Si vous échouez au 5 vous ne pourrez changer la difficulté.^000000";
				setdialogsize(300,200);
				.@hardmode = select( "Facile(1)", "Normal(2)", "Moyen(3)", "", "Difficile(5)", "", "Très Difficile(7)", "", "", "MALADE(10)", "", "", "", "", "Mindblown(15)", "", "", "", "", "Game Over(20)" );
			}
			callsub Process_Instance,.@md_name$,.@hardmode,.@turbo,.@questid;
			break;
			// warp_fct("e_tower", 72, 112);
		}
		case INST_FACEWORMS_NEST: { // Faceworm's Nest
			if( select( GetColor(12325)+"Acces direct^000000", "Se rendre sur place" ) == 1 ) {
				.@md_name$ = "Faceworm's Nest";
				.@questid = 12325; // Faceworm's Nest after-effects
				callsub Party_Check,.@md_name$;
				callsub Leader_Check; // Pour instance Solo
				callsub Process_Instance,.@md_name$,.@hardmode,.@turbo,.@questid;
				break;
			}
			warp_fct("dali", 85, 64);
		}
		case INST_GEFFEN_MAGIC_TOURNAMENT: { // Geffen Magic Tournament
			if( select( GetColor(9316)+"Acces direct^000000", "Se rendre sur place" ) == 1 ) {
				.@md_name$ = "Geffen Magic Tournament";
				.@questid = 9316; // Re-exploring the crack of spaces
				callsub Party_Check,.@md_name$;
				callsub Leader_Check; // Pour instance Solo

				if( checkquest(9309) != -1 ) {
					for( .@i = 9284; .@i <= 9314; .@i++ )
						if( checkquest(.@i) != -1 )
							erasequest .@i;

					if( checkquest(9315) != -1 )
						changequest 9315,9316;
				}

				if( checkquest(9308) != -1 ) {
					for( .@i = 9284; .@i <= 9314; .@i++ )
