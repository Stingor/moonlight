//===== Moonlight Script =====================================
//= Episode Clear Tickets, appele par le Warp Agent (menu Episodes)
//===== Description: =========================================
//= Porte de « Episode Valkyrie » (MondoTruth/standart-npc,
//= npc/ep-valk.txt, licence MIT, par Lil Art et MondoTruth).
//= Moonlight : une partie d'episode se joue UNE fois par compte
//= Moonlight. Finie sur un personnage (##epc_done_<partie>), un Episode
//= Clear Ticket la debloque pour tout le compte (##epc_tkt_<partie>) :
//= chaque autre personnage, y compris ceux crees plus tard, la recoit
//= comme terminee a sa connexion (EpisodeClear#login) ou en ouvrant le
//= menu, des qu'il remplit les conditions du jeu (niveau, partie
//= precedente). Ce qui attend l'histoire finie s'ouvre (instances,
//= quotidiennes, zones). Pas d'EXP, pas de recompense de quete. Un
//= ticket par partie. Les tickets se vendent contre des zenys (puits a
//= zenys voulu).
//= Un personnage qui a fini une partie avant ce script la note au compte
//= a sa prochaine connexion.
//=
//= Changements moonlight :
//= - fonction F_EpisodeClear au lieu d'un PNJ a Prontera, verrou
//=   Renewal (checkre) et F_SNPC_Off retires ;
//= - episode 20 ecrit ici, sur notre ep20_main (rAthena / brHades) et
//=   non le mod World Sync Extras ; episode 21 absent (pas d'histoire) ;
//= - deblocages au compte de l'histoire (##dun_open_issgard,
//=   ##dun_open_jor_root, ##dun_open_jor_twice) ;
//= - textes en francais.
//=
//= Les listes de quetes (OnInit de l'original, S_Init ici) ont ete
//= verifiees contre nos scripts charges : toutes y figurent.
//= Parties numerotees episode * 10 + partie : 131 = 13.1, 180 = 18.
//=
//= Usage : callfunc "F_EpisodeClear", .@npc_name$;
//= Revient a l'appelant sur « Menu Precedent », ferme sinon.
//= callfunc "F_EpisodeClear", "", 1; synchronise seulement (connexion).
//============================================================

function	script	F_EpisodeClear	{
	if (.init != 1)
		callsub S_Init;
	// Mode connexion (EpisodeClear#login) : synchronisation seule.
	if (getarg(1, 0)) {
		callsub S_Sync;
		return;
	}
	.@npc$ = getarg(0, "[ Warp Agent ]");
	// Un personnage monte de niveau sans se reconnecter : on rattrape ici.
	callsub S_Sync;
L_Menu:
	clear;
	mes .@npc$;
	mes "Terminez un épisode une fois, sur n'importe quel personnage : un ^0055FFEpisode Clear Ticket^000000 le débloque ensuite pour ^0055FFtout votre compte Moonlight^000000.";
	mes "Les autres personnages le reçoivent comme terminé, sans récompense ni EXP.";
	switch (select("• Utiliser un ticket:• Acheter un ticket:• Quels épisodes ?:• ^e64c00Menu Précédent^000000")) {
	case 1:
		.@part = callsub(S_PickPart);
		if (!.@part)
			goto L_Menu;
		.@ep = .@part / 10;
		.@name$ = callsub(S_Name, .@part);
		clear;
		mes .@npc$;
		if (getd("##epc_tkt_" + .@part)) {
			mes "L'épisode " + .@name$ + " est déjà débloqué pour tout votre compte Moonlight. Gardez votre ticket.";
			close;
		}
		if (!getd("##epc_done_" + .@part)) {
			mes "Un ticket sert aux autres personnages : terminez d'abord l'épisode " + .@name$ + " une fois, sur n'importe quel personnage de votre compte Moonlight.";
			mes "Si c'est déjà fait, connectez ce personnage une fois pour que je le sache.";
			close;
		}
		if (countitem(.ticket[.@ep]) < 1) {
			mes "Vous n'avez pas d'^0055FF" + getitemname(.ticket[.@ep]) + "^000000.";
			close;
		}
		mes "Utiliser un ^0055FF" + getitemname(.ticket[.@ep]) + "^000000 pour débloquer l'épisode " + .@name$ + " sur tout votre compte Moonlight ?";
		mes "Chaque personnage qui ne l'a pas fini le recevra comme terminé à sa connexion, dès qu'il remplit les conditions (niveau, épisode précédent). Ses quêtes encore ouvertes de cette chaîne seront fermées.";
		next;
		if (select("Oui, l'utiliser:Annuler") == 2)
			close;
		if (countitem(.ticket[.@ep]) < 1 || getd("##epc_tkt_" + .@part))
			close;
		delitem .ticket[.@ep], 1;
		setd "##epc_tkt_" + .@part, 1;
		logmes "EpisodeClear: ticket utilise partie " + callsub(S_Name, .@part) + " | " + callsub(S_LogState, .@ep);
		callsub S_Sync;
		specialeffect2 154;
		mes .@npc$;
		mes "C'est fait. L'épisode " + .@name$ + " est débloqué pour tout votre compte Moonlight.";
		if (!callsub(S_Done, .@part)) {
			.@prev = callsub(S_Prev, .@part);
			if (.@prev && !callsub(S_Done, .@prev))
				mes "Ce personnage le recevra une fois l'épisode " + callsub(S_Name, .@prev) + " terminé.";
			else
				mes callsub(S_Need, .@part) + " Ce personnage le recevra ensuite.";
		}
		close;
	case 2:
		goto L_Buy;
	case 3:
		clear;
		mes .@npc$;
		.@n = getarraysize(.ready);
		for (.@i = 0; .@i < .@n; .@i++) {
			.@p = .ready[.@i];
			if (callsub(S_Done, .@p))
				.@s$ = "^20a020terminé^000000";
			else
				.@s$ = "à faire";
			if (getd("##epc_tkt_" + .@p))
				.@s$ += ", compte : ^0055FFdébloqué^000000";
			else if (getd("##epc_done_" + .@p))
				.@s$ += ", compte : fini une fois";
			mes "Épisode " + callsub(S_Name, .@p) + " : " + .@s$;
		}
		mes "Un ticket débloque une partie pour tout le compte, une fois qu'elle a été finie sur un personnage. Les tickets des épisodes 13 à 16 servent pour chacune de leurs parties.";
		next;
		goto L_Menu;
	}
	return;

// Achat : on revient a la liste apres chaque ticket, sans fermer le Warp Agent.
L_Buy:
	.@n = getarraysize(.sell);
	.@menu$ = "";
	for (.@i = 0; .@i < .@n; .@i++)
		.@menu$ += "Ticket épisode " + .sell[.@i] + " (" + callfunc("F_InsertComma", .price[.sell[.@i]]) + " z):";
	clear;
	mes .@npc$;
	mes "Quel ticket voulez-vous acheter ?";
	.@c = select(.@menu$ + "^e64c00Menu Précédent^000000") - 1;
	if (.@c >= .@n)
		goto L_Menu;
	.@ep = .sell[.@c];
	clear;
	mes .@npc$;
	// Refuse seulement quand toutes les parties de l'episode sont deja
	// debloquees pour le compte.
	.@open = 0;
	.@n = getarraysize(.ready);
	for (.@i = 0; .@i < .@n; .@i++) {
		if (.ready[.@i] / 10 == .@ep && !getd("##epc_tkt_" + .ready[.@i]))
			.@open = 1;
	}
	if (!.@open) {
		mes "Tout ce que couvre un ticket de l'épisode " + .@ep + " est déjà débloqué pour votre compte Moonlight.";
		next;
		goto L_Buy;
	}
	mes "Un ^0055FF" + getitemname(.ticket[.@ep]) + "^000000 coûte " + callfunc("F_InsertComma", .price[.@ep]) + " zenys. Chaque ticket passe une partie.";
	next;
	if (select("L'acheter:Annuler") == 2)
		goto L_Buy;
	if (Zeny < .price[.@ep]) {
		mes .@npc$;
		mes "Vous n'avez pas assez de zenys.";
		next;
		goto L_Buy;
	}
	if (!checkweight(.ticket[.@ep], 1)) {
		mes .@npc$;
		mes "Vous portez trop de choses.";
		next;
		goto L_Buy;
	}
	Zeny -= .price[.@ep];
	getitem .ticket[.@ep], 1;
	logmes "EpisodeClear: achat ticket ep" + .@ep + " " + .price[.@ep] + "z | " + callsub(S_LogState, .@ep);
	mes .@npc$;
	mes "Voici votre ticket.";
	next;
	goto L_Buy;

// Demande une partie de .ready. La renvoie, ou 0 pour revenir.
// Pas de ':' dans un libelle : select() coupe le menu a chaque ':'.
S_PickPart:
	.@n = getarraysize(.ready);
	.@menu$ = "";
	for (.@i = 0; .@i < .@n; .@i++)
		.@menu$ += "Épisode " + callsub(S_Name, .ready[.@i]) + " (vous en avez " + countitem(.ticket[.ready[.@i] / 10]) + "):";
	.@c = select(.@menu$ + "^e64c00Menu Précédent^000000") - 1;
	if (.@c >= .@n)
		return 0;
	return .ready[.@c];

// Synchronise le personnage avec son compte Moonlight :
// 1. note au compte les parties que ce personnage a finies ;
// 2. applique, dans l'ordre de l'histoire, les parties debloquees par
//    ticket que ce personnage n'a pas finies, si leurs conditions sont
//    remplies (une partie appliquee peut ouvrir la suivante, d'ou .order).
// Un drapeau ## par partie : les ## sont lus a la connexion et le dernier
// ecrit gagne, un seul entier en masque de bits perdrait des parties.
S_Sync:
	.@n = getarraysize(.ready);
	for (.@i = 0; .@i < .@n; .@i++) {
		.@p = .ready[.@i];
		if (!getd("##epc_done_" + .@p) && callsub(S_Done, .@p))
			setd "##epc_done_" + .@p, 1;
	}
	.@n = getarraysize(.order);
	for (.@i = 0; .@i < .@n; .@i++) {
		.@p = .order[.@i];
		if (!.@p || !getd("##epc_tkt_" + .@p))
			continue;
		if (callsub(S_Done, .@p))
			continue;
		.@prev = callsub(S_Prev, .@p);
		if (.@prev && !callsub(S_Done, .@prev))
			continue;
		if (callsub(S_Need, .@p) != "")
			continue;
		callsub S_Skip, .@p;
		dispbottom "Épisode " + callsub(S_Name, .@p) + " : débloqué par votre compte Moonlight (Episode Clear Ticket).";
	}
	return;

// Etat de quete de l'episode pour logmes (npclog.mes : 255 caracteres).
// Niveau de base, variables de la chaine principale, puis par partie :
// j = finie sur ce personnage (S_Done), f = finie une fois au compte,
// t = debloquee par ticket au compte.
S_LogState:
	.@ep = getarg(0);
	.@s$ = "lv" + BaseLevel + " ";
	switch (.@ep) {
	case 13:
		.@s$ += "ryu=" + ep13_ryu + " newbs=" + ep13_newbs + " rhea=" + ep13_1_rhea + " edq=" + ep13_1_edq
			+ " rhea2=" + ep13_2_rhea + " mdrama=" + ep13_mdrama + " inv=" + ep13_3_invite + " secret=" + ep13_3_secret;
		break;
	case 14:
		.@s$ += "bs=" + ep14_1_bs + " mist=" + ep14_1_mistwoods + " mylord=" + ep14_2_mylord + " mors=" + ep14_3_mors01;
		break;
	case 15:
		.@s$ += "atnad=" + ep15_1_atnad + " elb=" + ep15_1_elb + " bslast=" + ep15_2_bslast;
		break;
	case 16:
		.@s$ += "royal=" + ep16_royal + " terra=" + terra_gloria_main;
		break;
	case 17:
		.@s$ += "terra=" + terra_gloria_main + " q16360=" + isbegin_quest(16360) + " ep17_2=" + ep17_2_main;
		break;
	case 18:
		.@s$ += "ep17_2=" + ep17_2_main + " ep18=" + ep18_main;
		break;
	case 19:
		.@s$ += "ep18=" + ep18_main + " ep19=" + ep19_main;
		break;
	case 20:
		.@s$ += "ep19=" + ep19_main + " ep20=" + ep20_main;
		break;
	}
	.@n = getarraysize(.ready);
	for (.@i = 0; .@i < .@n; .@i++) {
		.@p = .ready[.@i];
		if (.@p / 10 != .@ep)
			continue;
		.@s$ += " | " + callsub(S_Name, .@p) + " j" + callsub(S_Done, .@p)
			+ " f" + getd("##epc_done_" + .@p) + " t" + getd("##epc_tkt_" + .@p);
	}
	return .@s$;

// "18" pour 180, "17.2" pour 172.
S_Name:
	if (getarg(0) % 10)
		return (getarg(0) / 10) + "." + (getarg(0) % 10);
	return "" + (getarg(0) / 10);

// La partie avant celle-ci dans .order, ou 0 (aussi quand un 0 la precede).
S_Prev:
	.@n = getarraysize(.order);
	for (.@i = 1; .@i < .@n; .@i++) {
		if (.order[.@i] == getarg(0))
			return .order[.@i - 1];
	}
	return 0;

// Ce que le jeu demande avant le debut de la partie, en plus de la partie
// precedente : "" si rien ne manque, sinon le texte a afficher.
S_Need:
	switch (getarg(0)) {
	case 131:
		// Le Promotional Staff d'Izlude (quests_13_1.txt).
		if (BaseLevel < 70)
			return "L'épisode 13.1 demande le niveau de base 70.";
		break;
	case 132:
		if (countitem(2782) < 1 && !checkweight(2782, 1))
			return "Vous portez trop de choses pour recevoir l'anneau de l'ancien roi sage que donne l'épisode 13.2.";
		break;
	case 141:
		// Theore (quests_mora.txt).
		if (BaseLevel < 100)
			return "L'épisode 14.1 demande le niveau de base 100.";
		break;
	case 142:
		// Les voyageurs d'Eclage (quests_eclage.txt).
		if (BaseLevel < 99)
			return "L'épisode 14.2 demande le niveau de base 99.";
		break;
	case 143:
		// Les chiffons de Morroc (quests_14_3_bis.txt).
		if (BaseLevel < 140)
			return "L'épisode 14.3 demande le niveau de base 140.";
		break;
	case 151:
		// La secretaire Lime Evenor (quests_15_1.txt).
		if (BaseLevel < 140)
			return "L'épisode 15.1 demande le niveau de base 140.";
		if (countitem(6219) < 1 && countitem(22508) < 1)
			return "L'épisode 15.1 demande une Eden Group Mark : l'équipe de fouilles ne prend que des membres d'Eden.";
		break;
	case 161:
		// Le messager royal (quests_16_1.txt).
		if (BaseLevel < 100)
			return "L'épisode 16.1 demande le niveau de base 100.";
		if (ep13_ryu < 100 && ep13_start < 100)
			return "L'épisode 16.1 demande que la route du Nouveau Monde soit ouverte : Onward to the New World, ou la quête du Cat Paw Agent.";
		break;
	case 180:
		// Smart Elly (quests_17_2.npc).
		if (BaseLevel < 170)
			return "L'épisode 18 demande le niveau de base 170.";
		break;
	case 190:
		// Le villageois loup gris de Wolfvill (quests_19.npc).
		if (BaseLevel < 200)
			return "L'épisode 19 demande le niveau de base 200.";
		break;
	case 200:
		// Horuru a l'Ice Castle (quests_20_main.npc).
		if (BaseLevel < 215)
			return "L'épisode 20 demande le niveau de base 215.";
		break;
	}
	return "";

// Si la chaine principale de la partie est terminee.
S_Done:
	switch (getarg(0)) {
	case 131:
		// Fin des quatre histoires (quests_13_1.txt). Report from the New
		// World finit a 14 ; Nydhogg's Nest le passe a 15. Ses branches
		// utilisent 61-123 en route.
		return (ep13_ryu >= 100 && ep13_newbs >= 100 && ep13_1_rhea >= 100
			&& (ep13_1_edq == 14 || ep13_1_edq == 15));
	case 132:
		// L'anneau est fait ; 28 est la derniere discussion apres la
		// recompense d'Arc (quests_13_2.txt).
		return (ep13_2_rhea >= 100 && ep13_mdrama >= 27);
	case 133:
		// El Dicastes s'ouvre ; l'homme en noir au camp (quests_dicastes.txt).
		return (ep13_3_invite >= 6 && ep13_3_secret >= 24);
	case 141:
		// Recompense de Theore ; les mots du jeune homme ouvrent les
		// quotidiennes de Mora (quests_mora.txt, HazyForest).
		return (ep14_1_bs >= 19 && ep14_1_mistwoods >= 10);
	case 142:
		// Le chef d'etat-major (quests_eclage.txt) ; Avant au Flame Basin
		// le passe a 34.
		return (ep14_2_mylord >= 33);
	case 143:
		// Morse Cave nettoyee (quests_14_3_bis.txt, MorseCave).
		return (ep14_3_mors01 >= 1);
	case 151:
		// Ian Atnad ouvre les installations ; Looking for the Traces finit
		// avec Maggi (quests_15_1.txt).
		return (ep15_1_atnad >= 19 && ep15_1_elb >= 15);
	case 152:
		// Tatio au QG de Rekenber ; Vestige finit a la porte de la Last
		// Room (quests_15_2.txt).
		return (ep15_1_atnad >= 34 && ep15_2_bslast >= 9);
	case 161:
		// Fin de 16.1 : Friedrich Heine (quests_16_1.txt).
		return (ep16_royal >= 24);
	case 162:
		// Fin de 16.2 (quests_16_2.txt) ; 17.1 commence a 25.
		return (terra_gloria_main >= 25);
	case 171:
		// Ce que le jeu verifie lui-meme avant le debut de 17.2.
		return (isbegin_quest(16360) == 2);
	case 172:
		// Smart Elly lance 18 des 33 (quests_17_2.npc) : le couronnement
		// chez Nyhill (34 a 36) est un epilogue facultatif, beaucoup s'arretent
		// a 35 et finissent 18 et 19. Exiger 36 bloquait le ticket 17.2 et
		// donc 18 a 20 sur les autres personnages.
		return (ep17_2_main >= 33);
	case 180:
		return (ep18_main >= 57);
	case 190:
		// Derniere discussion d'Aurelie (quests_19.npc) : 61 a 100.
		return (ep19_main >= 100);
	case 200:
		// Derniere valeur de ep20_main (quests_20_main.npc).
		return (ep20_main >= 100);
	}
	return 0;

// Marque la chaine principale de la partie comme terminee.
S_Skip:
	switch (getarg(0)) {
	case 131:
		copyarray .@open[0], .q131[0], getarraysize(.q131);
		copyarray .@done[0], .q131_done[0], getarraysize(.q131_done);
		if (ep13_ryu < 100)
			ep13_ryu = 100;
		if (ep13_newbs < 100)
			ep13_newbs = 100;
		if (ep13_1_rhea < 100)
			ep13_1_rhea = 100;
		if (ep13_1_edq != 14 && ep13_1_edq != 15)
			ep13_1_edq = 14;
		break;
	case 132:
		copyarray .@open[0], .q132[0], getarraysize(.q132);
		copyarray .@done[0], .q132_done[0], getarraysize(.q132_done);
		ep13_2_rhea = 100;
		ep13_mdrama = 28;
		// Le traducteur (Ring_Of_Wise_King) : les Saphas ne parlent qu'a
		// qui le porte.
		if (countitem(2782) < 1)
			getitem 2782, 1;
		break;
	case 133:
		copyarray .@open[0], .q133[0], getarraysize(.q133);
		copyarray .@done[0], .q133_done[0], getarraysize(.q133_done);
		if (ep13_3_invite < 6)
			ep13_3_invite = 6;
		if (ep13_3_secret < 24)
			ep13_3_secret = 24;
		break;
	case 141:
		copyarray .@open[0], .q141[0], getarraysize(.q141);
		copyarray .@done[0], .q141_done[0], getarraysize(.q141_done);
		if (ep14_1_bs < 19)
			ep14_1_bs = 19;
		if (ep14_1_mistwoods < 10)
			ep14_1_mistwoods = 10;
		break;
	case 142:
		copyarray .@open[0], .q142[0], getarraysize(.q142);
		copyarray .@done[0], .q142_done[0], getarraysize(.q142_done);
		// L'entree d'Eclage : les formulaires des nouveaux visiteurs.
		if (ep14_2_oliver < 3)
			ep14_2_oliver = 3;
		ep14_2_mylord = 33;
		break;
	case 143:
		copyarray .@open[0], .q143[0], getarraysize(.q143);
		copyarray .@done[0], .q143_done[0], getarraysize(.q143_done);
		// Avant au Flame Basin.
		if (ep14_2_mylord < 34)
			ep14_2_mylord = 34;
		ep14_3_newerabs = 24;
		if (ep14_3_isle < 1)
			ep14_3_isle = 1;
		ep14_3_mors01 = 1;
		break;
	case 151:
		copyarray .@open[0], .q151[0], getarraysize(.q151);
		copyarray .@done[0], .q151_done[0], getarraysize(.q151_done);
		// Core Collection et le rapport de fouilles sont aussi des
		// quotidiennes : fermees seulement tant qu'elles sont celles de
		// l'histoire.
		if (ep15_1_atnad < 8 && isbegin_quest(7615) == 1)
			erasequest 7615;
		if (ep15_1_atnad < 13 && isbegin_quest(7617) == 1)
			erasequest 7617;
		if (ep15_1_atnad < 19) {
			ep15_1_atnad = 19;
			// Ce que donne Ian Atnad a la fin de 15.1 ; 15.2 commence avec.
			if (isbegin_quest(7641) == 0)
				setquest 7641;
			if (isbegin_quest(7642) == 0)
				setquest 7642;
		}
		if (ep15_2_permit < 1)
			ep15_2_permit = 1;
		if (ep15_1_elb < 15)
			ep15_1_elb = 15;
		break;
	case 152:
		copyarray .@open[0], .q152[0], getarraysize(.q152);
		copyarray .@done[0], .q152_done[0], getarraysize(.q152_done);
		ep15_1_atnad = 34;
		// Cinq jours de Memory Records ; 6 envoie chez Ian Atnad et au QG
		// de Rekenber.
		ep15_2_permit = 6;
		if (ep15_2_bslast < 9) {
			ep15_2_bslast = 9;
			ep15_2_bsmemo = 18;
		}
		break;
	case 161:
		copyarray .@open[0], .q161[0], getarraysize(.q161);
		copyarray .@done[0], .q161_done[0], getarraysize(.q161_done);
		ep16_royal = 24;
		// La lettre du messager royal, reprise a la villa royale.
		if (countitem(6933))
			delitem 6933, countitem(6933);
		break;
	case 162:
		copyarray .@open[0], .q162[0], getarraysize(.q162);
		copyarray .@done[0], .q162_done[0], getarraysize(.q162_done);
		terra_gloria_main = 25;
		// L'histoire du deuxieme etage ; 17 la demande a 10 ou plus.
		if (terra_gloria_lady_part < 10)
			terra_gloria_lady_part = 10;
		break;
	case 171:
		copyarray .@open[0], .q171[0], getarraysize(.q171);
		copyarray .@done[0], .q171_done[0], getarraysize(.q171_done);
		// Pose par Nihil au chateau de Prontera au debut de 17.1.
		if (terra_gloria_main < 26)
			terra_gloria_main = 26;
		break;
	case 172:
		copyarray .@open[0], .q172[0], getarraysize(.q172);
		copyarray .@done[0], .q172_done[0], getarraysize(.q172_done);
		ep17_2_main = 36;
		break;
	case 180:
		copyarray .@open[0], .q180[0], getarraysize(.q180);
		copyarray .@done[0], .q180_done[0], getarraysize(.q180_done);
		ep18_main = 57;
		break;
	case 190:
		copyarray .@open[0], .q190[0], getarraysize(.q190);
		copyarray .@done[0], .q190_done[0], getarraysize(.q190_done);
		// Le gardien Leon lance l'histoire de la Sainte de purification a
		// ep19_main 9 (la course de Boclind, 18128).
		if (ep19_side_saint < 1) {
			ep19_side_saint = 1;
			if (isbegin_quest(18128) == 0)
				setquest 18128;
		}
		ep19_main = 100;
		// Deblocage au compte d'Issgard (quests_19.npc).
		##dun_open_issgard = 1;
		// Les objets de l'histoire, repris par l'histoire : la lettre, la
		// coquille d'oeuf des Rgans, le registre, l'Ice Cookie, les tubes.
		setarray .@item[0], 1000607, 1000606, 1000845, 1000846, 1000604, 1000605;
		for (.@i = 0; .@i < 6; .@i++) {
			if (countitem(.@item[.@i]))
				delitem .@item[.@i], countitem(.@item[.@i]);
		}
		break;
	case 200:
		copyarray .@open[0], .q200[0], getarraysize(.q200);
		copyarray .@done[0], .q200_done[0], getarraysize(.q200_done);
		// Le travail des Rgans intermediaires (8847-8851) sert aussi a la
		// quotidienne 8853 : efface seulement pendant la premiere fois.
		if (isbegin_quest(8846) == 1) {
			for (.@i = 8847; .@i <= 8851; .@i++) {
				if (isbegin_quest(.@i) == 1)
					erasequest .@i;
			}
		}
		ep20_main = 100;
		// Deblocages au compte (quests_20_main.npc, etapes 16 et 36).
		##dun_open_jor_root = 1;
		##dun_open_jor_twice = 1;
		// Objets de l'histoire, repris par l'histoire : Ep20_Jor_Berry,
		// Ep20_Jor_Device.
		setarray .@item[0], 1001154, 1001218;
		for (.@i = 0; .@i < 2; .@i++) {
			if (countitem(.@item[.@i]))
				delitem .@item[.@i], countitem(.@item[.@i]);
		}
		break;
	}
	// Les quetes principales encore ouvertes sont fermees.
	.@n = getarraysize(.@open);
	for (.@i = 0; .@i < .@n; .@i++) {
		if (isbegin_quest(.@open[.@i]) == 1)
			erasequest .@open[.@i];
	}
	// Celles qu'une histoire finie laisse terminees.
	.@n = getarraysize(.@done);
	for (.@i = 0; .@i < .@n; .@i++) {
		if (isbegin_quest(.@done[.@i]) == 0)
			setquest .@done[.@i];
		if (isbegin_quest(.@done[.@i]) == 1)
			completequest .@done[.@i];
	}
	return;

S_Init:
	// Parties avec un vrai passage, dans l'ordre du menu.
	setarray .ready[0], 131, 132, 133, 141, 142, 143, 151, 152, 161, 162, 171, 172, 180, 190, 200;
	// Ordre de l'histoire. 14.1, 14.2, 15.1 et 16.1 ne demandent pas la
	// partie d'avant dans le jeu : un 0 commence une nouvelle chaine.
	setarray .order[0], 131, 132, 133, 0, 141, 0, 142, 143, 0, 151, 152, 0, 161, 162, 171, 172, 180, 190, 200;
	// Episode Clear Tickets (EpisodClear13 - EpisodClear20).
	.ticket[13] = 1000284;
	.ticket[14] = 1000285;
	.ticket[15] = 1000286;
	.ticket[16] = 1000282;
	.ticket[17] = 1000287;
	.ticket[18] = 1000288;
	.ticket[19] = 1000988;
	.ticket[20] = 1001214;
	// Prix des tickets en zenys.
	.price[13] = 1000000;
	.price[14] = 2000000;
	.price[15] = 3000000;
	.price[16] = 4000000;
	.price[17] = 5000000;
	.price[18] = 6000000;
	.price[19] = 7000000;
	.price[20] = 8000000;
	// Episodes dont les tickets sont vendus : ceux des parties pretes.
	deletearray .sell;
	.@n = getarraysize(.ready);
	for (.@i = 0; .@i < .@n; .@i++) {
		.@ep = .ready[.@i] / 10;
		if (inarray(.sell, .@ep) < 0)
			.sell[getarraysize(.sell)] = .@ep;
	}
	// Episode 13.1 (quests_13_1.txt) : Onward to the New World, ep13_ryu
	// 1 a 100 (10057-10078), New Surroundings, ep13_newbs 1 a 100
