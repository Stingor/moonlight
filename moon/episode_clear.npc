}

// Chaque connexion : note les episodes finis par ce personnage, et lui
// applique ceux que le compte a debloques par ticket.
-	script	EpisodeClear#login	-1,{
OnPCLoginEvent:
	callfunc "F_EpisodeClear", "", 1;
	end;
}
