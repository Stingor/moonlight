		11596, 11597, 11598, 11599, 11600, 11601, 11602, 11603,
		17015, 17016, 17017, 17018, 17019,
		16353, 16354, 16357, 16358, 16359, 16360;
	// Episode 17.2 (quests_17_2.npc) : ep17_2_main 1 a 36 (1 et 2 sont
