-	script	Cafard::eventcafard	-1,{
	end;

OnInit:
	// Recompenses : paires objet, quantite, tirees uniformement. Tout est
	// ouvert a tous, meme ce dont le joueur n'a pas encore debloque le contenu :
	// le gain doit donner envie d'aller y voir. Les quantites valent a peu pres
	// une run ou une quete quotidienne du contenu concerne.
	setarray .rew[0],
		// Contenu jusqu'a l'episode 16.2
		6419, 4,		// B Grade Coin (Malangdo)
		6418, 2,		// A Grade Coin (Malangdo)
		6820, 100,		// Energy Fragment (Nightmare Biolab)
		969, 30,		// Gold
		12246, 1,		// Mystical Card Album
		6607, 25,		// Temporal Crystal (Old Glast Heim)
		6608, 100,		// Coagulated Spell (Old Glast Heim)
		6719, 30,		// Jitterbug's Tooth
		6919, 30,		// Honor Token (16.1)
		7642, 30,		// Bloody Coin (Horror Toy Factory)
		6671, 30,		// Geffen Coin Magic Tournament
		25155, 30,		// Schwartz's Honor Token (16.2)
		// Episode 17.1
		25669, 25,		// Mysterious Component
		25723, 5,		// Cor Core
		// Episode 17.2
		1000104, 30,	// Magical Soapstone (non echangeable)
		1000103, 20,	// Barmil Ticket
		// Episodes 18 a 20
		1000405, 50,	// Amethyst Fragment (18)
		1000608, 25,	// Snow Flower (19)
		1001217, 20,	// Divine Cat Whiskers (20)
		// Illusion
		25271, 10,		// Illusion Stone
		25899, 20,		// Abyssal Essence (Illusion Underwater)
		// Instances
		1000367, 50,	// Minneas (Tomb of Remorse, non echangeable)
		1000257, 20,	// Piece of Sin (Thanatos Tower)
		1000263, 20,	// Fragment of Good Will (Thanatos Tower)
		1000373, 50,	// Meteorite Fragment (Constellation Tower)
		1000363, 10,	// Ymir Fragment (Airship Crash)
		1000316, 10,	// Geffen Arena Coin (Geffen Night Arena)
		25787, 10,		// Somatology Experimental Fragment (EDDA)
		25739, 10,		// Curse Eroded Crystal (EDDA Fall of Glast Heim)
		25814, 30;		// Dynite (Einbech, dun03)
	setarray .mobs[0], 1051, 1053, 1054;
	setarray .maps$[0],
				"gonryun",
				"alberta",
				"aldebaran",
				"amatsu",
				"ayothaya",
				"brasilis",
				"comodo",
				"dewata",
				"dicastes01",
				"eclage",
				"einbech",
				"einbroch",
				"geffen",
				"hugel",
				"izlude",
				"jawaii",
				"lasagna",
				"lighthalzen",
				"louyang",
				"xmas",
				"malangdo",
				"malaya",
	            "manuk",
	            "mora",
	            "morocc",
	            "moscovia",
	            "niflheim",
	            "payon",
	            "prontera",
	            "rachel",
	            "harboro1",
	            "splendide",
	            "umbala",
	            "veins",
	            "yuno";
	callsub S_Sync;
	end;
	
OnStart:
	$eventcafard = gettimetick(2);
	// Variables LOCALES : l'event peut lacher un cafard alors qu'un autre court
	// encore (OnMinute45 ne verifie rien). Avec .i / .m au niveau du NPC, le
	// second lache ecrasait les references du premier.
	.@map$ = .maps$[ rand( getarraysize(.maps$) ) ];
	.@mob = .mobs[ rand( getarraysize(.mobs) ) ];
	$eventcafardmap$ = .@map$;

	// Quel cafard traine sur quelle carte. Variable globale TEMPORAIRE : elle a
	// exactement la duree de vie du monstre (les deux disparaissent au reboot) et
	// ne laisse donc rien derriere elle dans mapreg. Lue par F_CafardMark, qui
	// affiche LE bon sprite dans le menu de l'agent de warp.
	setd "$@cafardmob_" + .@map$, .@mob;

	monster .@map$,0,0,"Etrange "+getmonsterinfo(.@mob, MOB_NAME),.@mob,1,"eventcafard::OnMobDead";
	callfunc "announce2","Un "+getmonsterinfo(.@mob, MOB_NAME)+" se balade dans "+getmapname(.@map$)+". Trouvez le et tuez le pour gagner !!",bc_blue|bc_all;
	end;

OnMobDead:
	.@r = rand( getarraysize(.rew) / 2 ) * 2;
	.@item = .rew[.@r];
	.@nb = .rew[.@r + 1];
	// killedrid = le monstre REELLEMENT tue. `.mobs[.m]` nommait le dernier
	// cafard lache, pas celui-ci : des que deux cafards coexistaient, l'annonce
	// et le log designaient la mauvaise bestiole.
	.@name$ = getmonsterinfo(killedrid, MOB_NAME);
	logmes "Trouve le "+.@name$+" et gagne 1pts d'event ainsi que "+.@nb+" "+getitemname(.@item);
	callfunc "announce2",strcharinfo(0)+" vient de chopper la bestiole "+ ( Sex ? "il":"elle" ) +" gagne 1pts d'event ainsi que "+.@nb+" "+getitemname(.@item)+"!!",bc_blue|bc_all;
	getitem .@item, .@nb;
	#KAFRAPOINTS += 1;
	callsub S_Sync;
	end;

// L'etat global suit les cafards encore en vie, pas le dernier evenement :
// tuer l'un d'eux ne remet rien a zero tant qu'un autre court. mobcount ne
// compte que les monstres a PV > 0, le cafard qu'on vient de tuer en est exclu.
S_Sync:
	.@left = 0;
	.@where$ = "";
	.@n = getarraysize(.maps$);
	for (.@i = 0; .@i < .@n; .@i++) {
		.@c = mobcount(.maps$[.@i], "eventcafard::OnMobDead");
		if (.@c > 0) {
			.@left += .@c;
			.@where$ = .maps$[.@i];
		}
	}
	if (.@left > 0) {
		if (!$eventcafard)
			$eventcafard = gettimetick(2);
		$eventcafardmap$ = .@where$;
	} else {
		$eventcafard = 0;
		$eventcafardmap$ = "";
	}
	return;
}

/* F_CafardMark("<carte>") -> marqueur a coller derriere un nom de ville dans un
 * menu, chaine vide si la carte est tranquille.
 *
 * C'est mobcount qui fait autorite, pas une liste tenue a la main : l'event
 * lache parfois plusieurs cafards a la fois, un reboot les emporte tous, et le
 * marqueur d'un menu doit dire ce que le joueur trouvera EN ARRIVANT. Un
 * compteur relu a l'affichage ne peut pas se desynchroniser ; une liste, si.
 *
 * Le sprite inline (<MOBS>) n'existe que dans le dialogue moderne du client.
 * Le dialogue natif, lui, laisse passer les balises qu'il ne connait pas et les
 * afficherait en toutes lettres, d'ou le repli en texte.
 */
function	script	F_CafardMark	{
	if( mobcount(getarg(0), "eventcafard::OnMobDead") < 1 )
		return "";
	.@mob = getd("$@cafardmob_" + getarg(0));
	if( !.@mob )
		.@mob = 1051;	// @reloadscript entre-temps : cafard generique
	return " " + mobsprite(.@mob);
}