//===== Moonlight-Destiny ====================================
function	script	overitems	{
	return (checkweight(Knife, getarg(0,1)) == 0);
}

function	script	overweight	{
	return (MaxWeight - Weight) < getarg(0,5000);
}

function	script	mesitemcell	{
	// Nom d'un objet précédé de son icône, cliquable : lien natif si le dialogue
	// moderne de Bourgeon est allumé chez le joueur, sinon lien objet du client.
	// Ne pose aucune espace autour, c'est à l'appelant de le faire.
	.@itemid = getarg(0,0);
	.@refine = getarg(1,0);
	.@name$ = getitemname(.@itemid);
	if( .@name$ == "null" ) return "item inconnu [id:" + .@itemid + "]";
	if( .@refine > 0 ) .@name$ = "+" + .@refine + " " + .@name$;
	// playerattached() en if imbriqué : rAthena n'a pas de court-circuit, et
	// bourgeon_ui() termine le script s'il n'y a aucun joueur attaché.
	if( playerattached() ) {
		if( bourgeon_ui(BOURGEON_UI_NPC_DIALOG) )
			return itemtag(.@itemid, .@name$);
	}
	// mesitemlink() ajoute un NBSP final (feature.mesitemlink_trailing_space).
	return mesitemicon(.@itemid) + mesitemlink(.@itemid, false, .@name$);
}

function	script	mesmoblink	{
	// Nom d'un monstre, cliquable : lien natif si le dialogue moderne de
	// Bourgeon est allumé chez le joueur, sinon lien web vers le bestiaire.
	// Ne pose aucune espace autour du nom, c'est à l'appelant de le faire.
	.@mobid = getarg(0,0);
	.@name$ = getmonsterinfo(.@mobid, MOB_NAME);
	if( .@name$ == "null" ) return "monstre inconnu [id:" + .@mobid + "]";

	// playerattached() en if imbriqué : rAthena n'a pas de court-circuit, et
	// bourgeon_ui() termine le script s'il n'y a aucun joueur attaché.
	if( playerattached() ) {
		if( bourgeon_ui(BOURGEON_UI_NPC_DIALOG) )
			return mobtag(.@mobid);
	}
	return meshyperlink(.@name$ + " [id:" + .@mobid + "]",
		"https://moonlight-destiny.fr/index.php?page=bestiary&mobid=" + .@mobid);
}

function	script	erasearray	{
	while( size(getarg(0)) ) arraypop(getarg(0));
	return;
}

function	script	MissionMVP	{
	if( !playerattached() ) return;
	.@killed_mob = killedrid;    // id du monstre tué
	.@killer_cid = getcharid(0); // sauvegarde pour restauration en fin de fonction

	if( .@killed_mob < 1 ) return;

	// --- Killer ---
	if( getarg(0,0) ) // Compte pour le classement ? (par défaut non)
		query_sql("UPDATE `char` SET mvp_count = mvp_count + 1 WHERE `char_id` = '" + .@killer_cid + "'");
	if( Mission_MVP != #Mission_Count_MVP && .@killed_mob == Mission_MVP_ID ) {
		Mission_MVP = 1;
		dispbottom "[Chasse MVP] Vous avez tué le MVP de votre mission, retournez voir Chuck !";
	}
	if( getarg(1,"") != "" ) // Message de log ? (par défaut aucun)
		logmes getarg(1);

	// --- Membres de party dans la même instance ---
	.@killer_map$ = strcharinfo(3);
	.@party_id    = getcharid(1);

	if( .@party_id > 0 ) {
		getpartymember(.@party_id, 2); // remplit $@partymembercid[] et $@partymembercount
		for( .@i = 0; .@i < $@partymembercount; ++.@i ) {
			if( $@partymembercid[.@i] == .@killer_cid ) continue; // déjà traité
			attachrid($@partymembercid[.@i]);
			if( !playerattached() ) continue;                     // hors-ligne
			if( strcharinfo(3) != .@killer_map$ ) continue;       // pas dans l'instance
			if( Mission_MVP == #Mission_Count_MVP ) continue;     // pas de mission ou déjà validée
			if( Mission_MVP_ID != .@killed_mob ) continue;        // mission différente
			Mission_MVP = 1;
			dispbottom "[Chasse MVP] Votre party a tué le MVP de votre mission, retournez voir Chuck !";
		}
		attachrid(.@killer_cid); // restaure le killer comme joueur attaché
	}
	return;
}

function	script	announce2	{
	.@color = getarg(2,-1);
	if( .@color == -1 )
		announce getarg(0),getarg(1);
	else 
		announce getarg(0),getarg(1),.@color;
	// query_sql("INSERT INTO `discord` (`text`) VALUES ('"+escape_sql(getarg(0))+"');");
	return;
}

function	script	mapannounce2	{
	.@color = getarg(3,-1);
	if( .@color == -1 )
		mapannounce getarg(0),getarg(1),getarg(2);
	else 
		mapannounce getarg(0),getarg(1),getarg(2),.@color;
	// query_sql("INSERT INTO `discord` (`text`) VALUES ('"+escape_sql(getarg(1))+"');");
	return;
}
function	script	getuniqueid	{
	query_sql("SELECT `user_id` FROM `login` WHERE `account_id` = '"+getarg(0)+"'", .@uniqueid);
	return .@uniqueid;
}

function	script	getusername	{
	query_sql("SELECT `username` FROM `site`.`phpbb_users` WHERE `user_id` = '"+getarg(0)+"'", .@username$);
	return .@username$;
}

function	script	getvote	{
	query_sql("SELECT `vote` FROM `vote` WHERE `user_id` = '"+getarg(0)+"'", .@vote);
	return .@vote;
}

function	script	getevent	{
	query_sql("SELECT `value` FROM `acc_reg_num` WHERE `key` = '#KAFRAPOINTS' AND `account_id` = '"+getarg(0)+"'", .@event);
	return .@event;
}

function	script	getuserid	{
	query_sql("SELECT `userid` FROM `login` WHERE `account_id` = '"+getarg(0)+"'", .@userid$);
	return .@userid$;
}

function	script	getcharname	{
	query_sql("SELECT `name` FROM `char` WHERE `char_id` = '"+getarg(0)+"'", .@name$);
	return .@name$;
}

// attachrid(getpartyleader(instance_live_info(ILI_OWNER), 1));
function	script	instancereward	{
	if( @norewardinstance ) {
		logmes "Récompenses non reçues pour cause de double account.";
		@norewardinstance = 0;
		return;
	}
	.@hm =  getarg(0,1);
	.@instance$ = getarg(1,"");
	.@zeny = getarg(2);
	.@zenyback = 0;
	explode(.@item$[0], getarg(3), ":");
	explode(.@amount$[0], getarg(4), ":");
	if( playerattached() ) {
		if( Zeny + .@zeny < MAX_ZENY )
			Zeny += .@Zeny;
		else if ( #BANKVAULT + .@zeny < MAX_ZENY ) {
			dispbottom .@Zeny+"z sont envoyés dans votre bank car vous êtes arrivez au max (Ctrl+b).";
			#BANKVAULT += .@Zeny;
		}
		else 
			dispbottom "Vous ne gagnez pas de zeny car vous êtes trop riche.";

		for( .@i = 0; .@i < size(.@item$); .@i++ ) {
			if( atoi(.@amount$[.@i]) < 1 ) continue;
			if( checkweight(atoi(.@item$[.@i]),atoi(.@amount$[.@i]))  )
				getitem atoi(.@item$[.@i]),atoi(.@amount$[.@i]);
			else {
				.@title$ = "Fin d'instance";
				.@body$ = "Félicitation vous avez terminé l'instance "+.@instance$+" !";
				setarray .@mailitem[0], atoi(.@item$[.@i]);
				setarray .@mailamount[0], atoi(.@amount$[.@i]);
				mail getcharid(0), .@instance$, .@title$, .@body$, .@zenyback, .@mailitem, .@mailamount;
				dispbottom "Une récompense vous est envoyée par mail ! (Pas de place)";
			}
		}
		logmes "Récompenses reçues.";
		return;
	}
	else
		logmes "Récompenses non reçues pour cause de double account.";
	return;
}

