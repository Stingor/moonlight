		getexp 954322,721363;
		close;
	case 3:
		switch( checkquest(8734,PLAYTIME) ) {
		case -1:
			break;
		case 0:
		case 1:
			mes "[Mirko]";
			mes "It's fine today. I'll take care of it tomorrow.";
			close;
		case 2:
