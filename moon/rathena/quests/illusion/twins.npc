		mes "Am I... a person?";
		mes "Could it be an ant?";
		mes "isn't it?";
		mes "Is it a person?";
		close;
	}
	if (ill_anthell == 4 || ill_anthell == 6) {
		mes "[Mick]";
		mes "It's strange. In my head, I know I'm a human, but when I see an ant passing by there, I wonder if I'm an ant";
		mes "What happened?";
		close;
	}
	mes "[Mick]";
	mes "Are you... a human?";
	close;

