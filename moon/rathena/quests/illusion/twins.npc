			erasequest 8724;
			erasequest 8725;
			erasequest 8726;
			erasequest 8727;
			setquest 8728;
			cloakonnpcself();
			cloakoffnpcself( "Rwella#part5" );
			specialeffect EF_DEFENDER, AREA, "Rwella#part5";
			mes "...I... I...!";
			mes "I...";
			mes "I thought...";
			close2;
			warp "anthell02",172,185;
			end;
		}
		next;
		mes "...";
		next;
		mes "== Welcome...? ==";
		next;
		mes "== Where is the real Khahris? ==";
		close;
	}
	end;

OnInit:
