//===== Moonlight ============================================
//= Old Glast Heim : mode defi - HUGINN2001, a cote d'Oscar.
//===== Description: =========================================
//= D'apres l'annonce officielle (renewal.playragnarok.com,
//= news 355) et ROGGH pour les tirages du demontage :
//=  - 5 Sealed Temporal Circlet -> un Circlet of Time ;
//=  - demontage d'un Sealed Temporal Circlet -> Temporal
//=    Fragment, Gemstone ou Spell au hasard ;
//=  - cartes Mutated Khalitzburg et Mutated White Knight contre
//=    50 Temporal Spell chacune.
//= Pas de Circlet pour l'Invocateur (pas de Doram jouable).
//= Voir docs/episodes/ogh_mode_defi.md.
//============================================================

glast_01,146,289,4	script	HUGINN2001#oghcm	2_VENDING_MACHINE1,{
	mes "[HUGINN2001]";
	mes "Bzzt... Hugin's dimensional exchange unit, model 2001.";
	mes "I process the materials of the contaminated dimension.";
	next;
	switch( select("Circlet of Time (5 Sealed Temporal Circlet):Dismantle Sealed Temporal Circlet:Exchange cards:Cancel") ) {
	case 1:
		callsub S_Circlet;
		end;
	case 2:
		callsub S_Dismantle;
		end;
	case 3:
		callsub S_Cards;
		end;
	}
	close;

S_Circlet:
	mes "[HUGINN2001]";
	mes "Insert ^0000FF5 Sealed Temporal Circlet^000000 and choose the circlet to forge.";
	next;
	for( .@i = 0; .@i < getarraysize(.circlet); .@i++ )
		.@menu$ += getitemname(.circlet[.@i]) + ":";
	.@s = select(.@menu$ + "Cancel") - 1;
	if( .@s >= getarraysize(.circlet) )
		close;
	.@id = .circlet[.@s];
	if( countitem(25864) < 5 ) {
		mes "[HUGINN2001]";
		mes "Insufficient material. ^FF0000" + countitem(25864) + "/5^000000 Sealed Temporal Circlet.";
		close;
	}
	if( checkweight(.@id,1) == 0 ) {
		mes "[HUGINN2001]";
		mes "You are carrying too much.";
		close;
	}
	mes "[HUGINN2001]";
	mes "Forge a <ITEM>" + getitemname(.@id) + "<INFO>" + .@id + "</INFO></ITEM>?";
	next;
	if( select("Forge.:Cancel.") == 2 )
		close;
	delitem 25864, 5;
	getitem .@id, 1;
	mes "[HUGINN2001]";
	mes "Process complete. Bzzt.";
	close;

S_Dismantle:
	.@have = countitem(25864);
	mes "[HUGINN2001]";
	mes "Each Sealed Temporal Circlet breaks into Temporal Fragments, and sometimes Temporal Gemstones or Temporal Spells.";
	mes "You have ^0000FF" + .@have + "^000000.";
	next;
	if( .@have < 1 )
		close;
	input .@n, 0, .@have;
	if( .@n < 1 )
		close;
	if( countitem(25864) < .@n )
		close;
	delitem 25864, .@n;
	for( .@k = 0; .@k < .@n; .@k++ ) {
		// Nombre de tirages : 1 61,1 %, 2 37,3 %, 3 1,5 %, 4 0,1 %.
		.@r = rand(1000);
		if( .@r < 611 )
			.@rolls = 1;
		else if( .@r < 984 )
			.@rolls = 2;
		else if( .@r < 999 )
			.@rolls = 3;
		else
			.@rolls = 4;
		for( .@j = 0; .@j < .@rolls; .@j++ ) {
			.@p = rand(10000);
			for( .@t = 0; .@t < getarraysize(.roll_rate); .@t++ ) {
				.@p -= .roll_rate[.@t];
				if( .@p < 0 )
					break;
			}
			if( .@t >= getarraysize(.roll_rate) )
				.@t = 0;
			.@got[.roll_item[.@t]] += .roll_amount[.@t];
		}
	}
	setarray .@out, 25867, 25865, 25866;
	mes "[HUGINN2001]";
	mes "Dismantled ^0000FF" + .@n + "^000000 circlet(s):";
	for( .@i = 0; .@i < 3; .@i++ ) {
		if( .@got[.@out[.@i]] > 0 ) {
			getitem .@out[.@i], .@got[.@out[.@i]];
			mes "- " + .@got[.@out[.@i]] + " " + getitemname(.@out[.@i]);
		}
	}
	close;

S_Cards:
	mes "[HUGINN2001]";
	mes "Card exchange: ^0000FF50 Temporal Spell^000000 each.";
	next;
	.@s = select(getitemname(27385) + ":" + getitemname(27384) + ":Cancel");
	if( .@s == 3 )
		close;
	.@card = ( .@s == 1 ? 27385 : 27384 );
	if( countitem(25866) < 50 ) {
		mes "[HUGINN2001]";
		mes "Insufficient material. ^FF0000" + countitem(25866) + "/50^000000 Temporal Spell.";
		close;
	}
	delitem 25866, 50;
	getitem .@card, 1;
	mes "[HUGINN2001]";
	mes "Exchange complete. Bzzt.";
	close;

OnInit:
	// Les 18 Circlet of Time (19492, Invocateur, ecarte).
	setarray .circlet, 19474, 19475, 19476, 19477, 19478, 19479, 19480, 19481, 19482, 19483, 19484, 19485, 19486, 19487, 19488, 19489, 19490, 19491;
	// Tirages du demontage (ROGGH), en dix-milliemes : objet, quantite, chance.
	setarray .roll_item,   25867, 25867, 25867, 25867, 25865, 25865, 25865, 25865, 25866, 25866, 25866, 25866;
	setarray .roll_amount, 4,     8,     12,    16,    1,     2,     3,     4,     1,     2,     3,     4;
	setarray .roll_rate,   7893,  1128,  142,   41,    587,   135,   34,    7,     20,    7,     7,     1;
	end;
}
