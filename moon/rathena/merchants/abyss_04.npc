//===== Moonlight Script =====================================
//= Abyss Lake F4 (abyss_04) : Bluehead et Redhead
//===== Description: =========================================
//= Ecrits pour Moonlight : la PR rAthena #7601 ne fournit pas ces deux PNJ
//= et aucun script libre n'existe. Recettes reprises d'iRO Wiki
//= (https://irowiki.org/wiki/Abyss4), boutique d'armes de Hugel.
//= - Bluehead : materiaux -> Dragon's Power (coffrets Lapine des options).
//=   Le Stable Dragon's Power ne s'obtient que sur Bone Detardeurus.
//= - Redhead : materiaux -> Dragon Plates, Dragon Scale Hood et Boots.
//============================================================

hu_in01,93,322,3	script	Bluehead#abyss04	1_M_SMITH,{
	.@npc$ = "[Bluehead]";
	mes .@npc$;
	mes "Dragon bones and dragon orbs from the Abyss Lake...";
	mes "Bring me enough of them and I'll condense a Dragon's Power for you.";
	next;
	switch( select( "Turbulent Dragon's Power (Dragon Plates)", "Burning Dragon's Power (Dragon Scale Hood)", "Hot Dragon's Power (Dragon Scale Boots)", "Cancel" ) ) {
	case 1:
		.@give$ = "Abyss_Ddbox";
		setarray .@qty[0], 1, 5, 12, 12, 12, 12, 12, 12;
		break;
	case 2:
		.@give$ = "Abyss_Ddbox3";
		setarray .@qty[0], 1, 2, 8, 8, 8, 8, 8, 8;
		break;
	case 3:
		.@give$ = "Abyss_Ddbox4";
		setarray .@qty[0], 1, 1, 7, 7, 7, 7, 7, 7;
		break;
	default:
		close;
	}
	setarray .@req$[0], "Drabone_L", "Drabone_S", "Dragenergy_Green", "Dragenergy_Blue", "Dragenergy_Red", "Dragenergy_Gold", "Dragenergy_Purple", "Dragenergy_Silver";
	mes .@npc$;
	mes "How many do you want? (1-50)";
	next;
	input .@amount, 0, 50;
	if (.@amount < 1)
		close;
	goto L_Craft;

L_Craft:
	.@size = getarraysize(.@req$);
	mes .@npc$;
	mes "For " + .@amount + " x " + getitemname(.@give$) + ", I need:";
	.@ok = 1;
	for ( .@i = 0; .@i < .@size; ++.@i ) {
		.@need = .@qty[.@i] * .@amount;
		.@have = countitem(.@req$[.@i]);
		if (.@have < .@need) {
			.@ok = 0;
			mes "^FF0000" + .@need + " " + getitemname(.@req$[.@i]) + " (" + .@have + ")^000000";
		}
		else
			mes "^0000FF" + .@need + " " + getitemname(.@req$[.@i]) + "^000000";
	}
	next;
	if (.@ok == 0) {
		mes .@npc$;
		mes "You don't have everything I need. Come back with the missing materials.";
		close;
	}
	if (select( "Exchange", "Cancel" ) == 2)
		close;
	if (checkweight(.@give$, .@amount) == 0) {
		mes .@npc$;
		mes "You are carrying too much. Make some room first.";
		close;
	}
	for ( .@i = 0; .@i < .@size; ++.@i ) {
		if (countitem(.@req$[.@i]) < .@qty[.@i] * .@amount) {
			mes .@npc$;
			mes "Hey, some materials just disappeared from your bag...";
			close;
		}
	}
	for ( .@i = 0; .@i < .@size; ++.@i )
		delitem .@req$[.@i], .@qty[.@i] * .@amount;
	getitem .@give$, .@amount;
	mes .@npc$;
	mes "Here you are. Use it well.";
	close;
}

hu_in01,95,322,3	script	Redhead#abyss04	4_F_JOB_BLACKSMITH,{
	.@npc$ = "[Redhead]";
	mes .@npc$;
	mes "I craft dragon equipment from the remains of the Abyss Lake dragons.";
	mes "One piece at a time, it's delicate work.";
	next;
	.@s = select( "Red Dragon Plate", "Green Dragon Plate", "Gold Dragon Plate", "Purple Dragon Plate", "Blue Dragon Plate", "Silver Dragon Plate", "Dragon Scale Hood", "Dragon Scale Boots", "Cancel" );
	if (.@s == 9)
		close;
	if (.@s <= 6) {
		setarray .@plate$[1], "DragonA_Red", "DragonA_Green", "DragonA_Gold", "DragonA_Purple", "DragonA_Blue", "DragonA_Silver";
		setarray .@orb$[1], "Dragenergy_Red", "Dragenergy_Green", "Dragenergy_Gold", "Dragenergy_Purple", "Dragenergy_Blue", "Dragenergy_Silver";
		.@give$ = .@plate$[.@s];
		setarray .@req$[0], .@orb$[.@s], "Drabone_L", "Drabone_S", "Dragon_Canine", "Dragon_Scale", "Dragon_Train", "Dragon's_Skin", "Dragonball_Green", "Dragonball_Blue", "Dragonball_Red", "Dragonball_Yellow";
		setarray .@qty[0], 50, 3, 15, 75, 100, 50, 100, 35, 35, 35, 35;
	}
	else if (.@s == 7) {
		.@give$ = "Drag_Manteau";
		setarray .@req$[0], "Drabone_L", "Drabone_S", "Dragon_Canine", "Dragon_Scale", "Dragon_Train", "Dragon's_Skin", "Dragonball_Green", "Dragonball_Blue", "Dragonball_Red", "Dragonball_Yellow";
		setarray .@qty[0], 2, 6, 15, 75, 15, 75, 25, 25, 25, 25;
	}
	else {
		.@give$ = "Dragon_Boots";
		setarray .@req$[0], "Drabone_L", "Drabone_S", "Dragon_Canine", "Dragon_Scale", "Dragon_Train", "Dragon's_Skin", "Dragonball_Green", "Dragonball_Blue", "Dragonball_Red", "Dragonball_Yellow";
		setarray .@qty[0], 1, 8, 30, 60, 40, 60, 25, 25, 25, 25;
	}
	.@amount = 1;
	.@size = getarraysize(.@req$);
	mes .@npc$;
	mes "For " + getitemname(.@give$) + ", I need:";
	.@ok = 1;
	for ( .@i = 0; .@i < .@size; ++.@i ) {
		.@have = countitem(.@req$[.@i]);
		if (.@have < .@qty[.@i]) {
			.@ok = 0;
			mes "^FF0000" + .@qty[.@i] + " " + getitemname(.@req$[.@i]) + " (" + .@have + ")^000000";
		}
		else
			mes "^0000FF" + .@qty[.@i] + " " + getitemname(.@req$[.@i]) + "^000000";
	}
	next;
	if (.@ok == 0) {
		mes .@npc$;
		mes "You're missing some materials. Come back when you have everything.";
		close;
	}
	if (select( "Craft it", "Cancel" ) == 2)
		close;
	if (checkweight(.@give$, 1) == 0) {
		mes .@npc$;
		mes "You are carrying too much. Make some room first.";
		close;
	}
	for ( .@i = 0; .@i < .@size; ++.@i ) {
		if (countitem(.@req$[.@i]) < .@qty[.@i]) {
			mes .@npc$;
			mes "Hey, some materials just disappeared from your bag...";
			close;
		}
	}
	for ( .@i = 0; .@i < .@size; ++.@i )
		delitem .@req$[.@i], .@qty[.@i];
	getitem .@give$, 1;
	mes .@npc$;
	mes "Done! A fine piece of dragon equipment.";
	close;
}
